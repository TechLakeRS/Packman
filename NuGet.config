<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Everything the solution needs is vendored in packages/, so the build works
         on a fully offline machine. clear drops any nuget.org source the machine
         has configured globally, which keeps restore from reaching the network. -->
    <clear />
    <add key="packman-offline" value="packages" />
  </packageSources>
</configuration>

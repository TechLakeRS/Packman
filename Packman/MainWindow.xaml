<ui:FluentWindow x:Class="Packman.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:Packman.Views"
        xmlns:vm="clr-namespace:Packman.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=True}"
        Title="{Binding ScreenTitle, StringFormat='PACKMAN — {0}'}"
        Width="1320" Height="860"
        MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UIFontFamily}"
        Background="{DynamicResource ShellBrush}"
        Foreground="{DynamicResource TextBrush}"
        Closing="MainWindow_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ TITLE BAR ═══════════ -->
        <!-- On the Mica backdrop, so no fill of its own. -->
        <ui:TitleBar Grid.Row="0" Height="44" Padding="16,0,0,0">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Mark: an outlined square holding a live-state dot. -->
                    <Border Width="16" Height="16" CornerRadius="3"
                            BorderBrush="{DynamicResource AccentTextBrush}" BorderThickness="1.5">
                        <Rectangle Width="5" Height="5" RadiusX="1" RadiusY="1" Fill="{DynamicResource OkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Packman" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource Text2Brush}"/>
                    <Border Width="1" Height="14" Background="{DynamicResource EdgeBrush}" Margin="12,0"/>
                    <TextBlock Text="{Binding ScreenTitle}" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource DimBrush}"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- ═══════════ BODY ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation pane: transparent so the backdrop carries it. -->
            <DockPanel Grid.Column="0" LastChildFill="False" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="CreatePackageNavBtn" Style="{StaticResource NavItem}" IsChecked="True" GroupName="Nav"
                                 Checked="CreatePackageNavBtn_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18">
                                <Path Data="{StaticResource IconBox}" Fill="Transparent" StrokeThickness="1.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                            <TextBlock Text="Create Package" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="UploadIntuneNavBtn" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Checked="UploadIntuneNavBtn_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18">
                                <Path Data="{StaticResource IconUpload}" Fill="Transparent" StrokeThickness="1.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                            <TextBlock Text="Upload to Intune" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ApplicationsNavBtn" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Checked="ApplicationsNavBtn_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18">
                                <Path Data="{StaticResource IconLaptop}" Fill="Transparent" StrokeThickness="1.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                            <TextBlock Text="Applications" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RemoteTestNavBtn" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Checked="RemoteTestNavBtn_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18">
                                <Path Data="{StaticResource IconPulse}" Fill="Transparent" StrokeThickness="1.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                            <TextBlock Text="Remote Test" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="AdvancedNavBtn" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Checked="AdvancedNavBtn_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18">
                                <Path Data="{StaticResource IconApp}" Fill="Transparent" StrokeThickness="1.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                            <TextBlock Text="Advanced" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Footer: settings, the signed-in account, then the build stamp. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,10,16,0">
                    <TextBlock Text="PSADT v4 · GRAPH BETA" FontFamily="{StaticResource LabelFontFamily}" FontSize="10"
                               FontWeight="SemiBold" Foreground="{DynamicResource FaintBrush}"/>
                    <TextBlock Text="{Binding RuntimeStamp}" FontFamily="{StaticResource MonoFontFamily}" FontSize="10"
                               Foreground="{DynamicResource FaintBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <RadioButton x:Name="SettingsNavBtn" DockPanel.Dock="Bottom" Style="{StaticResource NavItem}" GroupName="Nav"
                             Checked="SettingsNavBtn_Checked">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="18" Height="18">
                            <Path Data="{StaticResource IconGear}" Fill="Transparent" StrokeThickness="1.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                        <TextBlock Text="Settings" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </DockPanel>

            <!-- Content surface: the one opaque layer, rounded into the pane. -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,1,0,0"
                    CornerRadius="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="28"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <!-- ═══════ CREATE PACKAGE ═══════ -->
                        <Grid x:Name="CreatePackagePage">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Wizard header + stepper -->
                            <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                                    Padding="30,22,30,0" Visibility="{Binding IsWizard, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                            <TextBlock Text="Create Package" Style="{StaticResource H1}"/>
                                            <TextBlock Text="Build a new application package for Intune deployment"
                                                       Style="{StaticResource SubText}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding PackagePathShort}" Style="{StaticResource Caption}"
                                                   MaxWidth="420" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding PackagePathShort}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                    </Grid>

                                    <!-- Stepper: a top rule per step, filled once the step is reached. -->
                                    <ItemsControl ItemsSource="{Binding Steps}" Margin="0,18,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:StepViewModel}">
                                                <Button Cursor="Hand" Margin="0,0,20,0"
                                                        Command="{Binding DataContext.GoToStepCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        CommandParameter="{Binding Index}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent">
                                                                <ContentPresenter/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <StackPanel>
                                                        <Border Height="3" CornerRadius="2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource EdgeBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                            <Setter Property="Opacity" Value="0.45"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        <StackPanel Orientation="Horizontal" Margin="0,9,0,11">
                                                            <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="11" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{Binding Number}"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource Dim2Brush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                                <Setter Property="Text" Value="&#x2713;"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Title}" Margin="8,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Muted3Brush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Tool header (Edit Script / Remote Test) -->
                            <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                                    Padding="30,20,30,16" Visibility="{Binding IsToolOpen, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Button Style="{StaticResource Breadcrumb}" Command="{Binding CloseToolCommand}">
                                        <TextBlock>
                                            <Run Text="← Create Package /"/><Run Text=" "/><Run Text="{Binding PackageName, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Button>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding ToolTitle}" Style="{StaticResource H1}"/>
                                            <TextBlock Text="{Binding ToolSubtitle}" Style="{StaticResource SubText}"
                                                       Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="optional step" Style="{StaticResource Caption}"
                                                   Margin="16,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Step and tool content share the row; one is visible at a time.
                                 StepEdit hosts a WebView2, which is HWND-based and ignores WPF
                                 clipping, so it fills the viewport and scrolls internally
                                 instead of sitting in a ScrollViewer. -->
                            <Grid Grid.Row="1">
                                <!-- The wizard steps go away entirely while a tool covers them; left
                                     visible they render and take clicks underneath the open tool. -->
                                <Grid Visibility="{Binding IsWizard, Converter={StaticResource BoolToVis}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="{Binding Steps[0].IsCurrent, Converter={StaticResource BoolToVis}}">
                                        <views:StepGenerate Margin="30,22,30,26"/>
                                    </ScrollViewer>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="{Binding Steps[1].IsCurrent, Converter={StaticResource BoolToVis}}">
                                        <views:StepUpload Margin="30,22,30,26"/>
                                    </ScrollViewer>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="{Binding Steps[2].IsCurrent, Converter={StaticResource BoolToVis}}">
                                        <views:StepReview Margin="30,22,30,26"/>
                                    </ScrollViewer>
                                </Grid>
                                <views:StepEdit x:Name="EditStep" Margin="30,18,30,22"
                                                Visibility="{Binding IsEditToolOpen, Converter={StaticResource BoolToVis}}"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{Binding IsTestToolOpen, Converter={StaticResource BoolToVis}}">
                                    <views:StepTest Margin="30,18,30,22" DataContext="{Binding RemoteTest}"/>
                                </ScrollViewer>
                            </Grid>

                            <!-- Wizard footer -->
                            <Border Grid.Row="2" Height="60" Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="30,0"
                                    Visibility="{Binding IsWizard, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Button Style="{StaticResource BackButton}" Content="← Back"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding BackCommand}"/>
                                    <TextBlock Text="{Binding StepPosition}" Style="{StaticResource Caption}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GhostButton}" Content="Uploading…" IsEnabled="False"
                                                Visibility="{Binding IsUploadRunning, Converter={StaticResource BoolToVis}}"/>
                                        <Button Command="{Binding PrimaryCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUploadRunning}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding PrimaryLabel}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Text="↵" Margin="9,0,0,0" Opacity="0.55" VerticalAlignment="Center"
                                                           FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                                                           Visibility="{Binding ShowPrimaryKeyHint, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Tool footer -->
                            <Border Grid.Row="2" Height="60" Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="30,0"
                                    Visibility="{Binding IsToolOpen, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Button Style="{StaticResource BackButton}" Content="← Back to package"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding CloseToolCommand}"/>
                                    <TextBlock Text="changes are saved to the package on disk" Style="{StaticResource Caption}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding IsEditToolOpen, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GhostButton}" Content="{Binding ToolActionLabel}"
                                                Click="ToolAction_Click" Margin="0,0,12,0"
                                                Visibility="{Binding IsEditToolOpen, Converter={StaticResource BoolToVis}}"/>
                                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ContinueToUploadCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Continue to upload" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Text="↵" Margin="9,0,0,0" Opacity="0.55" VerticalAlignment="Center"
                                                           FontFamily="{StaticResource MonoFontFamily}" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <views:RemoteTestView x:Name="RemoteTestPage" Visibility="Collapsed"/>
                        <views:SettingsView x:Name="SettingsPage" Visibility="Collapsed"/>
                        <views:UploadToIntuneView x:Name="UploadIntunePage" Visibility="Collapsed"/>
                        <views:ApplicationsView x:Name="ApplicationsPage" Visibility="Collapsed"/>
                        <views:ApplicationDetailView x:Name="AppDetailPage" Visibility="Collapsed"/>
                        <views:AdvancedView x:Name="AdvancedPage" Visibility="Collapsed"/>
                    </Grid>

                    <!-- ═══════════ STATUS BAR ═══════════ -->
                    <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                        <DockPanel Margin="18,0" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="{Binding AppVersion}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                                           Foreground="{DynamicResource Dim2Brush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Ellipse Width="6" Height="6">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource MarkBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource OkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ConnectionStatusText}" Margin="9,0,0,0"
                                           FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                                           Foreground="{DynamicResource Muted2Brush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ConnectionStatusText}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>

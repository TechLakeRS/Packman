<UserControl x:Class="Packman.Views.StepGenerate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Packman.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Packman"
             mc:Ignorable="d"
             FontFamily="{StaticResource UIFontFamily}">

    <StackPanel>
        <!-- Mode toggle + upload cross-link -->
        <Grid Margin="0,0,0,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Style="{StaticResource SegmentGroup}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource ModeToggle}" GroupName="GenMode" Content="Create new"
                                 IsChecked="{Binding IsUpgradeMode, Mode=TwoWay, Converter={StaticResource InverseBool}}"/>
                    <RadioButton Style="{StaticResource ModeToggle}" GroupName="GenMode" Content="Upgrade existing"
                                 IsChecked="{Binding IsUpgradeMode, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="12">
                <Run Text="Already have a built package?" Foreground="{DynamicResource Muted2Brush}"/>
                <Hyperlink Click="UploadExisting_Click" Foreground="{DynamicResource AccentTextBrush}" TextDecorations="{x:Null}" FontWeight="SemiBold">
                    Upload it directly →
                </Hyperlink>
            </TextBlock>
        </Grid>

        <!-- ═══ CREATE NEW ═══ -->
        <StackPanel Visibility="{Binding IsUpgradeMode, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel Margin="0,0,0,14">
                <controls:SectionHeader Title="Start with your installer"/>
                <TextBlock Text="Choose the source first. Review the detected details before generating your package." Style="{StaticResource SubText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="22,20,22,22">
                <StackPanel>
                    <!-- Sources path: browse sits inside the field, hint sits under it -->
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Style="{StaticResource FieldLabel}">
                            <Run Text="Source installer"/><Run Text=" *" Foreground="{DynamicResource AccentTextBrush}"/>
                        </TextBlock>
                        <Grid Margin="0,6,0,0">
                            <TextBox AutomationProperties.Name="Source installer" Style="{StaticResource MonoField}" Padding="11,0,86,0"
                                     local:PlaceholderText.Text="Choose or drop an MSI / EXE installer"
                                     Text="{Binding CreatePackage.SourcesPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewDragOver="SourcesPath_DragOver" Drop="SourcesPath_Drop"
                                     AllowDrop="True"/>
                            <Button Style="{StaticResource BrowseButton}" Content="Browse…"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,5,0" Click="BrowseButton_Click"/>
                        </Grid>
                        <TextBlock Text="Drop an MSI or EXE here — metadata, icon and product code are read automatically."
                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="12" LineHeight="18"
                                   Foreground="{DynamicResource Dim2Brush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="Manufacturer"/><Run Text=" *" Foreground="{DynamicResource AccentTextBrush}"/>
                            </TextBlock>
                            <TextBox AutomationProperties.Name="Manufacturer" Style="{StaticResource TextField}" Margin="0,6,0,0"
                                     local:PlaceholderText.Text="e.g. Mozilla"
                                     Text="{Binding CreatePackage.Manufacturer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Grid.Row="0">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="Application Name"/><Run Text=" *" Foreground="{DynamicResource AccentTextBrush}"/>
                            </TextBlock>
                            <TextBox AutomationProperties.Name="Application Name" Style="{StaticResource TextField}" Margin="0,6,0,0"
                                     local:PlaceholderText.Text="e.g. Firefox"
                                     Text="{Binding CreatePackage.AppName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="2">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="Version"/><Run Text=" *" Foreground="{DynamicResource AccentTextBrush}"/>
                            </TextBlock>
                            <TextBox AutomationProperties.Name="Version" Style="{StaticResource MonoField}" Margin="0,6,0,0"
                                     local:PlaceholderText.Text="e.g. 124.0.1"
                                     Text="{Binding CreatePackage.Version, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Grid.Row="2">
                            <TextBlock Text="Architecture" Style="{StaticResource FieldLabel}"/>
                            <ComboBox AutomationProperties.Name="Architecture" Margin="0,6,0,0" SelectedValuePath="Content"
                                      SelectedValue="{Binding CreatePackage.Architecture, Mode=TwoWay}">
                                <ComboBoxItem Content="x64"/>
                                <ComboBoxItem Content="x86"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Install context -->
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Install Context" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource SegmentGroup}" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource ContextToggle}" GroupName="Ctx" Content="System"
                                                 IsChecked="{Binding CreatePackage.UserInstall, Mode=TwoWay, Converter={StaticResource InverseBool}}"/>
                                    <RadioButton Style="{StaticResource ContextToggle}" GroupName="Ctx" Content="User"
                                                 IsChecked="{Binding CreatePackage.UserInstall, Mode=TwoWay}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,9"
                                   FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource Muted2Brush}"
                                   Text="{Binding CreatePackage.InstallContextHelp}"/>
                    </Grid>

                </StackPanel>
            </Border>


                <Border Grid.Column="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="22,0,0,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Package preview" Style="{StaticResource H2}"/>
                        <TextBlock Text="PSADT v4 · Win32 application" Style="{StaticResource SubText}" Margin="0,6,0,18" TextWrapping="Wrap"/>
                        <TextBlock Text="Application" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding CreatePackage.AppName}" Foreground="{DynamicResource InkBrush}" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <TextBlock Text="Publisher" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding CreatePackage.Manufacturer}" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <TextBlock Text="Version" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding CreatePackage.Version}" Style="{StaticResource SubText}" Margin="0,0,0,16"/>
                        <TextBlock Text="Output share" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding SettingsService.Settings.NetworkPaths.IntuneApplications}" Style="{StaticResource SubText}" TextWrapping="Wrap"/>
                        <TextBlock Text="Your package contains Application, Intune and Icon folders." Style="{StaticResource SubText}" Margin="0,18,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Generation status -->
            <StackPanel Margin="0,16,0,0">
                <Rectangle Width="6" Height="6" RadiusX="3" RadiusY="3" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Fill" Value="{DynamicResource MarkBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPackage}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource OkBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
                <TextBlock Text="{Binding CreatePackage.StatusText}" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFontFamily}" FontSize="12" LineHeight="18"
                           Foreground="{DynamicResource Muted2Brush}" TextWrapping="Wrap"/>
                <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="12"
                           Visibility="{Binding HasPackage, Converter={StaticResource BoolToVis}}">
                    <Hyperlink Command="{Binding NewPackageCommand}" Foreground="{DynamicResource AccentTextBrush}"
                               TextDecorations="{x:Null}" FontWeight="SemiBold">start a new package</Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- Optional tools, offered once a package exists -->
            <StackPanel Visibility="{Binding HasPackage, Converter={StaticResource BoolToVis}}">
                <controls:SectionHeader Title="Prepare for deployment" Caption="Edit and test before publishing" Margin="0,26,0,14"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="9"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="9"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding OpenEditToolCommand}" Style="{StaticResource ToolCard}">
                        <StackPanel>
                            <TextBlock Text="Edit script" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                            <TextBlock Text="Review install and uninstall commands. EXE packages need their actual silent switches." Margin="0,8,0,0"
                                       FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource Muted2Brush}"/>
                            <TextBlock Text="Invoke-AppDeployToolkit.ps1" Margin="0,8,0,0"
                                       FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{DynamicResource DimBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Command="{Binding OpenTestToolCommand}" Style="{StaticResource ToolCard}">
                        <StackPanel>
                            <TextBlock Text="Remote test" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                            <TextBlock Text="Install on a test machine and verify the detection rule." Margin="0,8,0,0"
                                       FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource Muted2Brush}"/>
                            <TextBlock Text="deploy to a device" Margin="0,8,0,0"
                                       FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{DynamicResource DimBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4" Command="{Binding OpenPackageFolderCommand}" Style="{StaticResource ToolCard}">
                        <StackPanel>
                            <TextBlock Text="Open folder" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                            <TextBlock Text="Inspect the package on the network share." Margin="0,8,0,0"
                                       FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource Muted2Brush}"/>
                            <TextBlock Text="{Binding PackageName}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                                       FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{DynamicResource DimBrush}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </StackPanel>

        <!-- ═══ UPGRADE EXISTING ═══ -->
        <StackPanel Visibility="{Binding IsUpgradeMode, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="0,0,0,14">
                <controls:SectionHeader Title="Upgrade an existing package"/>
                <TextBlock Text="create a new version, reusing the existing install logic" Style="{StaticResource SubText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="22,20,22,22">
                <StackPanel>
                    <TextBlock Text="Existing Package Folder" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,6,0,0">
                        <TextBox AutomationProperties.Name="Existing Package Folder" Style="{StaticResource MonoField}" Padding="11,0,86,0" IsReadOnly="True"
                                 local:PlaceholderText.Text="Select the existing PSADT package folder"
                                 Text="{Binding Upgrade.ExistingPackagePath, Mode=OneWay}"/>
                        <Button Style="{StaticResource BrowseButton}" Content="Browse…"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,5,0" Click="BrowseUpgradePackage_Click"/>
                    </Grid>

                    <Border Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            Padding="14,12" Margin="0,12,0,0"
                            Visibility="{Binding Upgrade.HasLoadedPackage, Converter={StaticResource BoolToVis}}" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="{Binding Upgrade.PackageDisplayName}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="{Binding Upgrade.PackageDisplayVersion}" FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="12" Foreground="{DynamicResource Muted2Brush}"/>
                                <TextBlock Text=" · " FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                           Foreground="{DynamicResource Dim2Brush}"/>
                                <TextBlock Text="{Binding Upgrade.PackageDisplayContext}" FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="12" Foreground="{DynamicResource Muted2Brush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="New Source File" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,6,0,0">
                                <TextBox AutomationProperties.Name="New Source File" Style="{StaticResource MonoField}" Padding="11,0,86,0" IsReadOnly="True"
                                         local:PlaceholderText.Text="Select the new MSI/EXE"
                                         Text="{Binding Upgrade.NewSourcePath, Mode=OneWay}"/>
                                <Button Style="{StaticResource BrowseButton}" Content="Browse…"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,5,0" Click="BrowseUpgradeSource_Click"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="New Version" Style="{StaticResource FieldLabel}"/>
                            <TextBox AutomationProperties.Name="New Version" Style="{StaticResource MonoField}" Margin="0,6,0,0"
                                     local:PlaceholderText.Text="e.g. 125.0"
                                     Text="{Binding Upgrade.NewVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Margin="0,16,0,0">
                <Rectangle Width="6" Height="6" RadiusX="3" RadiusY="3" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource MarkBrush}"/>
                <TextBlock Text="{Binding Upgrade.StatusText}" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFontFamily}" FontSize="12" LineHeight="18"
                           Foreground="{DynamicResource Muted2Brush}" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>

<UserControl x:Class="Packman.Views.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Packman"
             xmlns:vm="clr-namespace:Packman.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ApplicationsViewModel}"
             FontFamily="{StaticResource UIFontFamily}">

    <Grid Margin="26,20,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Applications" Style="{StaticResource H1}"/>
                <TextBlock Text="Browse and manage Win32 applications in your connected Intune tenant" Style="{StaticResource SubText}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding RangeText}" Style="{StaticResource Caption}" Margin="0,0,14,0"/>
                <Button Style="{StaticResource GhostButton}" Content="Refresh"
                        Command="{Binding RefreshCommand}" ToolTip="Reload from Intune"/>
            </StackPanel>
        </Grid>

        <!-- Search + filters -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBox Grid.ColumnSpan="5" Style="{StaticResource TextField}" AutomationProperties.Name="Search applications"
                local:PlaceholderText.Text="Search applications by name or publisher…" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
            <ComboBox Grid.Row="2" AutomationProperties.Name="Filter by manufacturer" ItemsSource="{Binding Manufacturers}" SelectedItem="{Binding SelectedManufacturer, Mode=TwoWay}"/>
            <ComboBox Grid.Row="2" Grid.Column="2" AutomationProperties.Name="Filter by category" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"/>
            <ComboBox Grid.Row="2" Grid.Column="4" AutomationProperties.Name="Filter by last updated" ItemsSource="{Binding UpdatedWindows}" SelectedItem="{Binding SelectedUpdatedWindow, Mode=TwoWay}"/>
        </Grid>

        <!-- Table -->
        <Border Grid.Row="2" Background="{DynamicResource ShellBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Column heads -->
                <Border Grid.Row="0" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="18"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Style="{StaticResource Breadcrumb}" Command="{Binding SortByNameCommand}"
                                Margin="12,0,0,0" ToolTip="Sort by name">
                            <TextBlock Text="{Binding NameHeader}" Style="{StaticResource ColHead}"
                                       FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0"/>
                        </Button>
                        <TextBlock Grid.Column="2" Text="Category" Style="{StaticResource ColHead}" FontSize="12" Margin="0"/>
                        <TextBlock Grid.Column="3" Text="Version" Style="{StaticResource ColHead}" FontSize="12" Margin="0"/>
                        <Button Grid.Column="4" Style="{StaticResource Breadcrumb}" Command="{Binding SortByUpdatedCommand}"
                                ToolTip="Sort by last updated">
                            <TextBlock Text="{Binding UpdatedHeader}" Style="{StaticResource ColHead}" FontSize="12" Margin="0"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Rows -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Page}" AlternationCount="2"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True" Focusable="False"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" FocusVisualStyle="{StaticResource FocusVisualInset}" AutomationProperties.Name="{Binding DisplayName}" Cursor="Hand" HorizontalContentAlignment="Stretch" Height="60">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="rb" BorderThickness="2,0,0,1" Padding="12,0,14,0"
                                                Background="Transparent" BorderBrush="{DynamicResource Line2Brush}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!-- Zebra striping via alternation, hover lights the left edge. -->
                                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="1">
                                                <Setter TargetName="rb" Property="Background" Value="{DynamicResource Card2Brush}"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="rb" Property="Background" Value="{DynamicResource PrimaryFaintBrush}"/>
                                                <Setter TargetName="rb" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="18"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="26" Height="26" BorderBrush="{DynamicResource Edge2Brush}" BorderThickness="1" CornerRadius="4">
                                        <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource LabelFontFamily}"
                                                   FontSize="12" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <Grid Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Publisher}" FontSize="12" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource Muted3Brush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" BorderBrush="{DynamicResource WarnLineBrush}" BorderThickness="1" Padding="7,4" Margin="9,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding ShowStateWarning, Converter={StaticResource BoolToVis}}" CornerRadius="4">
                                            <TextBlock Text="{Binding StateWarningText}" FontFamily="{StaticResource LabelFontFamily}"
                                                       FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Column="2" Text="{Binding Category}" VerticalAlignment="Center" Margin="0,0,12,0"
                                               FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Version}" VerticalAlignment="Center" Margin="0,0,12,0"
                                               FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                               Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="4" Text="{Binding UpdatedText}" VerticalAlignment="Center" Margin="0,0,12,0"
                                               FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                               Foreground="{DynamicResource Muted3Brush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="5" Text="›" VerticalAlignment="Center" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                               Foreground="{DynamicResource FaintBrush}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Loading / empty / not-connected all paint over the list area. -->
                <StackPanel Grid.Row="1" Margin="18,34" Background="{DynamicResource ShellBrush}"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <Ellipse Width="34" Height="34" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="2"
                             StrokeDashArray="22 8" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Ellipse.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock Text="{Binding LoadStatus}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                               Foreground="{DynamicResource Muted2Brush}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="18,28" Background="{DynamicResource ShellBrush}"
                            Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="No applications to show" Foreground="{DynamicResource InkBrush}" FontSize="13.5"
                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                               Foreground="{DynamicResource Muted2Brush}" Margin="0,8,0,0" LineHeight="18"
                               HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="18,40" Background="{DynamicResource ShellBrush}"
                            Visibility="{Binding ShowConnectPrompt, Converter={StaticResource BoolToVis}}">
                    <!-- Same mark as the title bar, scaled up. -->
                    <Border Width="34" Height="34" CornerRadius="6" BorderBrush="{DynamicResource AccentTextBrush}"
                            BorderThickness="1.5" HorizontalAlignment="Center">
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource MarkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Not connected to Microsoft Intune" Foreground="{DynamicResource InkBrush}" FontSize="13.5"
                               FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    <TextBlock Text="Connect to your tenant on the Settings page to browse applications from Intune."
                               FontFamily="{StaticResource MonoFontFamily}" FontSize="12" LineHeight="18"
                               Foreground="{DynamicResource Muted2Brush}" Margin="0,8,0,0"
                               HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ConnectCommand}"
                            Content="Open Settings" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                </StackPanel>

                <!-- Pager -->
                <Border Grid.Row="2" Height="56" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,1,0,0" Padding="14,0"
                        Visibility="{Binding ShowPager, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <TextBlock Text="{Binding RangeText}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                   Foreground="{DynamicResource Muted3Brush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Content="← Previous" Padding="11,7"
                                    Command="{Binding PrevPageCommand}"/>
                            <TextBlock Text="{Binding PageDisplay}" VerticalAlignment="Center" Margin="14,0"
                                       FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                       Foreground="{DynamicResource Text2Brush}"/>
                            <Button Style="{StaticResource GhostButton}" Content="Next →" Padding="11,7"
                                    Command="{Binding NextPageCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="Packman.Views.AdvancedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Packman.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Packman"
             xmlns:vm="clr-namespace:Packman.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdvancedViewModel}"
             FontFamily="{StaticResource UIFontFamily}">


    <Grid Margin="26,20,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Advanced" Style="{StaticResource H1}"/>
            <TextBlock Text="Bulk and reverse-lookup actions the Intune portal doesn't offer" Style="{StaticResource SubText}" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Tab strip -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabBulkAdd" Style="{StaticResource PageTab}" GroupName="AdvancedTabs" IsChecked="True">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" Margin="0,0,8,0">
                            <Path Data="{StaticResource IconGroup}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" StrokeThickness="1.8" Style="{StaticResource Icon}"/>
                        </Viewbox>
                        <TextBlock Text="Bulk add PCs to group" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabPcGroups" Style="{StaticResource PageTab}" GroupName="AdvancedTabs">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" Margin="0,0,8,0">
                            <Path Data="{StaticResource IconLaptop}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" StrokeThickness="1.8" Style="{StaticResource Icon}"/>
                        </Viewbox>
                        <TextBlock Text="PC group membership" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabGroupApps" Style="{StaticResource PageTab}" GroupName="AdvancedTabs">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" Margin="0,0,8,0">
                            <Path Data="{StaticResource IconApp}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" StrokeThickness="1.8" Style="{StaticResource Icon}"/>
                        </Viewbox>
                        <TextBlock Text="Apps assigned to group" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Not connected -->
                <Border Style="{StaticResource Card}" Padding="30,44" Visibility="{Binding ShowConnectPrompt, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Border Width="52" Height="52" CornerRadius="4" Background="{DynamicResource PrimaryDimBrush}" HorizontalAlignment="Center">
                            <Viewbox Width="24" Height="24">
                                <Path Data="{StaticResource IconShield}" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.8" Style="{StaticResource Icon}"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Not connected to Microsoft Intune" Foreground="{DynamicResource InkBrush}" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="Connect to your tenant on the Settings page to use the advanced directory actions."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ConnectCommand}"
                                HorizontalAlignment="Center" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Go to Settings to connect" VerticalAlignment="Center"/>
                                <Viewbox Width="14" Height="14" Margin="8,0,0,0">
                                    <Path Data="{StaticResource IconChevR}" Stroke="{DynamicResource PrimaryFgBrush}" StrokeThickness="2.2" Style="{StaticResource Icon}"/>
                                </Viewbox>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">

                    <!-- ══ 1. Bulk add PCs to a group ══════════════════════ -->
                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding IsChecked, ElementName=TabBulkAdd, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
<StackPanel Margin="0,0,0,14">
    <controls:SectionHeader Title="BULK ADD PCS TO A GROUP"/>
    <TextBlock Text="Paste a list of PC names — one per line, or separated by commas — and add them all at once." Style="{StaticResource SubText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
</StackPanel>

                            <TextBlock Text="Target group" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                            <Grid>
                                <TextBox AutomationProperties.Name="Target group" Style="{StaticResource TextField}"
                                         local:PlaceholderText.Text="Search Entra groups…"
                                         Text="{Binding BulkGroupSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    CornerRadius="4" Margin="0,8,0,0" MaxHeight="180"
                                    Visibility="{Binding HasBulkGroupResults, Converter={StaticResource BoolToVis}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding BulkGroupResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource PickerRow}" Click="BulkGroupResult_Click">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12.5" Foreground="{DynamicResource InkBrush}" Margin="12,8" TextTrimming="CharacterEllipsis"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <!-- Confirms the typed name resolved to a real group before anything is added -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="{Binding HasBulkGroupCheck, Converter={StaticResource BoolToVis}}">
                                <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconCheck}" StrokeThickness="2.6">
                                        <Path.Style>
                                            <Style TargetType="Path" BasedOn="{StaticResource Icon}">
                                                <Setter Property="Stroke" Value="{DynamicResource MutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBulkGroupConfirmed}" Value="True">
                                                        <Setter Property="Stroke" Value="{DynamicResource OkBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Viewbox>
                                <TextBlock Text="{Binding BulkGroupCheck}" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBulkGroupConfirmed}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Text="PC names" Style="{StaticResource FieldLabel}" Margin="0,16,0,5"/>
                            <!-- Plain TextBox in a card border: the TextField style is single-line (hidden scrollbars, centred content) -->
                            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4">
                                <TextBox AutomationProperties.Name="PC names" Height="150" AcceptsReturn="True" TextWrapping="Wrap" Padding="12,10"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource InkBrush}" CaretBrush="{DynamicResource InkBrush}"
                                         SelectionBrush="{DynamicResource PrimaryDimBrush}"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5"
                                         Text="{Binding PcNames, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Border>
                            <TextBlock Text="One name per line, or separated by commas, semicolons or spaces."
                                       FontSize="11.5" Foreground="{DynamicResource Muted2Brush}" Margin="0,6,0,0"/>

                            <Grid Margin="0,12,0,0">
                                <TextBlock Text="{Binding PcNameCountText}" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                                        Content="Add to group" Command="{Binding BulkAddCommand}"/>
                            </Grid>

                            <TextBlock Text="{Binding BulkStatus}" Margin="0,12,0,0" TextWrapping="Wrap"
                                       FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                                       Visibility="{Binding HasBulkStatus, Converter={StaticResource BoolToVis}}"/>

                            <!-- Per-PC results -->
                            <Border Background="{DynamicResource Card2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    CornerRadius="4" Margin="0,12,0,0" MaxHeight="320"
                                    Visibility="{Binding HasBulkRows, Converter={StaticResource BoolToVis}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding BulkRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,0,0,1">
                                                    <Grid Margin="14,9">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="160"/>
                                                            <ColumnDefinition Width="Auto" MinWidth="130"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding PcName}" VerticalAlignment="Center"
                                                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5"
                                                                   Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center"
                                                                   FontSize="12" FontWeight="Bold" Margin="12,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Added">
                                                                            <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Not found">
                                                                            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                            <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" VerticalAlignment="Center"
                                                                   FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ══ 2. PC → groups ══════════════════════════════════ -->
                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding IsChecked, ElementName=TabPcGroups, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
<StackPanel Margin="0,0,0,14">
    <controls:SectionHeader Title="GROUPS A PC BELONGS TO"/>
    <TextBlock Text="Type a PC name to see every group it is a direct member of." Style="{StaticResource SubText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
</StackPanel>

                            <Grid>
                                <TextBox Style="{StaticResource TextField}"
                                         local:PlaceholderText.Text="Search PC names…"
                                         Text="{Binding DeviceSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    CornerRadius="4" Margin="0,8,0,0" MaxHeight="200"
                                    Visibility="{Binding HasDeviceResults, Converter={StaticResource BoolToVis}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding DeviceResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource PickerRow}" Click="DeviceResult_Click">
                                                    <StackPanel Margin="12,7">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="12.5" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <TextBlock Text="{Binding DeviceStatus}" Margin="0,14,0,0" TextWrapping="Wrap"
                                       FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                                       Visibility="{Binding HasDeviceStatus, Converter={StaticResource BoolToVis}}"/>

                            <Border Background="{DynamicResource Card2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    CornerRadius="4" Margin="0,12,0,0"
                                    Visibility="{Binding HasDeviceGroups, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding DeviceGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,0,0,1">
                                                <Grid Margin="14,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                                                            Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                                        <TextBlock Text="{Binding MembershipType}" FontSize="10.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource MutedBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ══ 3. Group → apps ═════════════════════════════════ -->
                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding IsChecked, ElementName=TabGroupApps, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
<StackPanel Margin="0,0,0,14">
    <controls:SectionHeader Title="APPS ASSIGNED TO A GROUP"/>
    <TextBlock Text="Type a group name to see every app that targets it. Graph has no reverse lookup, so the app list is scanned." Style="{StaticResource SubText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
</StackPanel>

                            <Grid>
                                <TextBox Style="{StaticResource TextField}"
                                         local:PlaceholderText.Text="Search Entra groups…"
                                         Text="{Binding AppGroupSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    CornerRadius="4" Margin="0,8,0,0" MaxHeight="180"
                                    Visibility="{Binding HasAppGroupResults, Converter={StaticResource BoolToVis}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AppGroupResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource PickerRow}" Click="AppGroupResult_Click">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12.5" Foreground="{DynamicResource InkBrush}" Margin="12,8" TextTrimming="CharacterEllipsis"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <TextBlock Text="{Binding AppScanStatus}" Margin="0,14,0,0" TextWrapping="Wrap"
                                       FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                                       Visibility="{Binding HasAppScanStatus, Converter={StaticResource BoolToVis}}"/>

                            <Border Background="{DynamicResource Card2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    CornerRadius="4" Margin="0,12,0,0"
                                    Visibility="{Binding HasGroupApps, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding GroupApps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,0,0,1">
                                                <Grid Margin="14,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto" MinWidth="110"/>
                                                        <ColumnDefinition Width="Auto" MinWidth="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Publisher}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding AppType}" VerticalAlignment="Center" Margin="12,0"
                                                               FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding IntentText}" VerticalAlignment="Center"
                                                               FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

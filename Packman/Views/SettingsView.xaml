                                </StackPanel>

                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Network Paths card -->
                    <Border Background="Transparent" BorderThickness="0" Padding="0"
                            Visibility="{Binding IsChecked, ElementName=TabNetworkPaths, Converter={StaticResource BoolToVis}}">
                        <StackPanel>

                            <!-- Card header -->
<StackPanel Margin="0,0,0,14">
    <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="NETWORK PATHS" Style="{StaticResource SectionLabel}"/>
        <Border Style="{StaticResource Rule}" Margin="12,0,0,0"/>
    </DockPanel>
    <TextBlock Text="File share locations for package output and PSADT template" Style="{StaticResource SubText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
</StackPanel>

                            <!-- Intune Applications output path -->

        <Border Style="{StaticResource Rule}" Margin="12,0,0,0"/>
    </DockPanel>
    <TextBlock Text="App details, requirements and return codes applied to every package unless changed on the Create Package page" Style="{StaticResource SubText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
</StackPanel>

                            <!-- ── App details ────────────────────────────────── -->

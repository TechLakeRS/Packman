                                    <TextBox AutomationProperties.Name="Uninstall group name template" Style="{StaticResource TextField}" FontFamily="{StaticResource MonoFontFamily}"
                                             Text="{Binding UninstallGroupNameTemplate, UpdateSourceTrigger=PropertyChanged}"
                                             local:PlaceholderText.Text="%vendor%_%appName%_%appVersion%_Uninstall"/>
                                </Grid>
                                <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap">
                                    <Run Text="Always assigned with the Uninstall intent."/>
                                    <LineBreak/>
                                    <Run Text="Example: "/>
                                    <Run Text="{Binding UninstallGroupNamePreview, Mode=OneWay}" Foreground="{DynamicResource AccentTextBrush}" FontFamily="{StaticResource MonoFontFamily}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Divider -->
                            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,18,0,18"/>

                            <!-- ── Existing groups ────────────────────────────── -->
                            <TextBlock Text="Always assign these existing groups" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                            <TextBlock Text="Every upload is also assigned to the groups listed below" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,12"/>

                            <!-- Add group row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

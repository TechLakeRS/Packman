                            <TextBlock Text="Sent with every Win32 app created in Intune" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,12"/>

                            <TextBlock Text="App title template" Style="{StaticResource FieldLabel}"/>

                                            <TextBlock Text="Required" VerticalAlignment="Center"/>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Divider -->
                            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,18,0,18"/>


                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Code}" FontSize="13" FontWeight="SemiBold"
                                                               FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource InkBrush}"/>
                                                    <TextBox Style="{StaticResource TextField}" Margin="0,6,0,0" Height="30" FontSize="12"
                                                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                             local:PlaceholderText.Text="Description (shown in Packman only)"/>
                                                </StackPanel>
                                                <!-- Outcome toggle -->
                                                <Border Grid.Column="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                                                        BorderThickness="1" CornerRadius="4" Padding="3" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton Style="{StaticResource ContextToggle}" IsChecked="{Binding IsSuccess}">
                                                            <TextBlock Text="Success" VerticalAlignment="Center"/>
                                                        </RadioButton>
                                                        <RadioButton Style="{StaticResource ContextToggle}" Margin="3,0,0,0" IsChecked="{Binding IsSoftReboot}">
                                                            <TextBlock Text="Soft reboot" VerticalAlignment="Center"/>
                                                        </RadioButton>
                                                        <RadioButton Style="{StaticResource ContextToggle}" Margin="3,0,0,0" IsChecked="{Binding IsHardReboot}">
                                                            <TextBlock Text="Hard reboot" VerticalAlignment="Center"/>
                                                        </RadioButton>
                                                        <RadioButton Style="{StaticResource ContextToggle}" Margin="3,0,0,0" IsChecked="{Binding IsRetry}">
                                                            <TextBlock Text="Retry" VerticalAlignment="Center"/>
                                                        </RadioButton>
                                                        <RadioButton Style="{StaticResource ContextToggle}" Margin="3,0,0,0" IsChecked="{Binding IsFailed}">
                                                            <TextBlock Text="Failed" VerticalAlignment="Center"/>
                                                        </RadioButton>
                                                    </StackPanel>
                                                </Border>
                                                <!-- Remove -->
                                                <Button Grid.Column="2" Style="{StaticResource RowIconButton}" Command="{Binding RemoveCommand}"
                                                        VerticalAlignment="Center" ToolTip="Remove">
                                                    <Viewbox Width="15" Height="15">
                                                        <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    </Viewbox>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </Border>

                    <!-- bottom padding -->
                    <Border Height="16"/>

                </StackPanel>
        </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

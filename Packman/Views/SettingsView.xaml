                                <TextBox AutomationProperties.Name="IntuneWinAppUtil Path" Style="{StaticResource TextField}"
                                         Text="{Binding IntuneWinAppUtilPath, UpdateSourceTrigger=PropertyChanged}"
                                         local:PlaceholderText.Text="\\server\share\Tools\IntuneWinAppUtil.exe"/>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- Group Assignment card -->
                    <Border Background="Transparent" BorderThickness="0" Padding="0"
                            Visibility="{Binding IsChecked, ElementName=TabGroupAssignment, Converter={StaticResource BoolToVis}}">
                        <StackPanel>

                            <!-- Card header -->
<StackPanel Margin="0,0,0,14">
    <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="GROUP ASSIGNMENT" Style="{StaticResource SectionLabel}"/>
        <Border Style="{StaticResource Rule}" Margin="12,0,0,0"/>
    </DockPanel>
    <TextBlock Text="Assign uploaded packages to Entra ID groups automatically" Style="{StaticResource SubText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
</StackPanel>

                            <!-- ── Per-package group ──────────────────────────── -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Create an install group for each package" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                    <TextBlock Text="A security group is created (or reused if it already exists) on upload and assigned to the app" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <!-- On / Off toggle -->
                                <Border Grid.Column="1" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="GroupPerPackage"
                                                     IsChecked="{Binding CreateGroupPerPackageDisabled}">
                                            <TextBlock Text="Off" VerticalAlignment="Center"/>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="GroupPerPackage" Margin="3,0,0,0"
                                                     IsChecked="{Binding CreateGroupPerPackage}">
                                            <TextBlock Text="On" VerticalAlignment="Center"/>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Naming template + intent (only when On) -->
                            <StackPanel Visibility="{Binding CreateGroupPerPackage, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Install group name template" Style="{StaticResource FieldLabel}"/>
                                <Grid Margin="0,7,0,0">
                                    <TextBox AutomationProperties.Name="Install group name template" Style="{StaticResource TextField}" FontFamily="{StaticResource MonoFontFamily}"
                                             Text="{Binding GroupNameTemplate, UpdateSourceTrigger=PropertyChanged}"
                                             local:PlaceholderText.Text="%vendor%_%appName%_%appVersion%_Install"/>
                                </Grid>
                                <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap">
                                    <Run Text="Tokens:"/>
                                    <Run Text=" %vendor% " FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextBrush}"/>
                                    <Run Text="%appName% " FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextBrush}"/>
                                    <Run Text="%appVersion%" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextBrush}"/>
                                    <Run Text="  ·  Mix in any literal text, e.g."/>
                                    <Run Text=" %vendor%_%appName%_%appVersion%_Install" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextBrush}"/>
                                    <LineBreak/>
                                    <Run Text="Example: "/>
                                    <Run Text="{Binding GroupNamePreview, Mode=OneWay}" Foreground="{DynamicResource AccentTextBrush}" FontFamily="{StaticResource MonoFontFamily}"/>
                                </TextBlock>

                                <!-- Assignment intent for the new group -->
                                <TextBlock Text="Assignment type" Style="{StaticResource FieldLabel}" Margin="0,14,0,7"/>
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"

                                             local:PlaceholderText.Text="any"
                                             Text="{Binding DefaultMinProcessors, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Minimum CPU speed (MHz)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox AutomationProperties.Name="Minimum CPU speed (MHz)" Style="{StaticResource TextField}" Margin="0,7,0,0"

                                    <TextBox AutomationProperties.Name="Group name to add" Style="{StaticResource TextField}"
                                             Text="{Binding NewGroupNameInput, UpdateSourceTrigger=PropertyChanged}"
                                             local:PlaceholderText.Text="Entra ID group display name"/>

                                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="UninstallGroupPerPackage" Margin="3,0,0,0"
                                                     IsChecked="{Binding CreateUninstallGroupPerPackage}">
                                            <TextBlock Text="On" VerticalAlignment="Center"/>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Visibility="{Binding CreateUninstallGroupPerPackage, Converter={StaticResource BoolToVis}}">

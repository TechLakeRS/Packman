<UserControl x:Class="Packman.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Packman.Views.Controls"
             xmlns:local="clr-namespace:Packman"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="{StaticResource UIFontFamily}">

    <Grid Margin="26,20,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Page header ══════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Settings" Style="{StaticResource H1}"/>
                <TextBlock Text="Connections, package paths and deployment defaults"
                           Style="{StaticResource SubText}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Reset -->
                <Button Style="{StaticResource GhostButton}" Content="Reset" Command="{Binding ResetCommand}" Margin="0,0,8,0"/>
                <!-- Save Settings -->
                <Button Style="{StaticResource PrimaryButton}" Content="Save settings" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource LineBrush}"/>

        <!-- ══ Sections + content ═══════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

<!-- ══ First-run setup banner ═══════════════════════════════════ -->
        <Border Grid.ColumnSpan="3" Background="{DynamicResource WarnSoftBrush}"
                BorderBrush="{DynamicResource WarnBrush}" BorderThickness="2,0,0,0"
                Padding="12,11" Margin="0,0,0,20" CornerRadius="4"
                Visibility="{Binding ShowFirstRunBanner, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconBulb}" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.8" Style="{StaticResource Icon}"/>
                </Viewbox>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5">
                    <Run Text="First-run setup" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                    <Run Text="  Set the package output folder, full PSADT v4 template and IntuneWinAppUtil path. Sign in to Intune, then save."
                         Foreground="{DynamicResource MutedBrush}"/>
                </TextBlock>
                <Button Grid.Column="2" Style="{StaticResource RowIconButton}" Command="{Binding DismissFirstRunCommand}"
                        VerticalAlignment="Center" ToolTip="Dismiss">
                    <Viewbox Width="12" Height="12">
                        <Path Data="{StaticResource IconX}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" Style="{StaticResource Icon}"/>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>
            <ScrollViewer Grid.Column="0" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                <RadioButton x:Name="TabAuth" Style="{StaticResource SectionItem}" GroupName="SettingsTabs" IsChecked="True">
                    <DockPanel LastChildFill="False" Width="160">
                        <TextBlock DockPanel.Dock="Left" Text="Authentication" VerticalAlignment="Center"/>
                    </DockPanel>
                </RadioButton>
                <RadioButton x:Name="TabCodeSign" Style="{StaticResource SectionItem}" GroupName="SettingsTabs">
                    <DockPanel LastChildFill="False" Width="160">
                        <TextBlock DockPanel.Dock="Left" Text="Code Signing" VerticalAlignment="Center"/>
                    </DockPanel>
                </RadioButton>
                <RadioButton x:Name="TabNetworkPaths" Style="{StaticResource SectionItem}" GroupName="SettingsTabs">
                    <DockPanel LastChildFill="False" Width="160">
                        <TextBlock DockPanel.Dock="Left" Text="Network Paths" VerticalAlignment="Center"/>
                    </DockPanel>
                </RadioButton>
                <RadioButton x:Name="TabGroupAssignment" Style="{StaticResource SectionItem}" GroupName="SettingsTabs">
                    <DockPanel LastChildFill="False" Width="160">
                        <TextBlock DockPanel.Dock="Left" Text="Group Assignment" VerticalAlignment="Center"/>
                    </DockPanel>
                </RadioButton>
                <RadioButton x:Name="TabIntuneDefaults" Style="{StaticResource SectionItem}" GroupName="SettingsTabs">
                    <DockPanel LastChildFill="False" Width="160">
                        <TextBlock DockPanel.Dock="Left" Text="Intune Defaults" VerticalAlignment="Center"/>
                    </DockPanel>
                </RadioButton>
                <RadioButton x:Name="TabAppearance" Style="{StaticResource SectionItem}" GroupName="SettingsTabs">
                    <DockPanel LastChildFill="False" Width="160">
                        <TextBlock DockPanel.Dock="Left" Text="Appearance" VerticalAlignment="Center"/>
                    </DockPanel>
                </RadioButton>
            </StackPanel></ScrollViewer>

        <!-- ══ Tab content ══════════════════════════════════════════════ -->
        <ScrollViewer Grid.Column="2" Grid.Row="1" Margin="0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <controls:AuthenticationSettings Visibility="{Binding IsChecked, ElementName=TabAuth, Converter={StaticResource BoolToVis}}"/>

                    <controls:AppearanceSettings Visibility="{Binding IsChecked, ElementName=TabAppearance, Converter={StaticResource BoolToVis}}"/>

                    <controls:CodeSigningSettings Visibility="{Binding IsChecked, ElementName=TabCodeSign, Converter={StaticResource BoolToVis}}"/>

                    <controls:NetworkPathsSettings Visibility="{Binding IsChecked, ElementName=TabNetworkPaths, Converter={StaticResource BoolToVis}}"/>

                    <controls:GroupAssignmentSettings Visibility="{Binding IsChecked, ElementName=TabGroupAssignment, Converter={StaticResource BoolToVis}}"/>

                    <controls:IntuneDefaultsSettings Visibility="{Binding IsChecked, ElementName=TabIntuneDefaults, Converter={StaticResource BoolToVis}}"/>

                    <!-- bottom padding -->
                    <Border Height="16"/>

                </StackPanel>
        </ScrollViewer>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding SaveStatus}" Style="{StaticResource SubText}" Margin="218,14,0,0"
            TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</UserControl>

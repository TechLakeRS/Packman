<UserControl x:Class="Packman.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Packman"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="{StaticResource UIFontFamily}">

    <Grid Margin="26,20,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Page header ══════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Settings" Style="{StaticResource H1}"/>
                <TextBlock Text="Stored in appsettings.json next to the executable"
                           Style="{StaticResource SubText}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Save status -->
                <TextBlock Text="{Binding SaveStatus}" FontFamily="{StaticResource MonoFontFamily}" FontSize="10.5"
                           Foreground="{DynamicResource OkBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <!-- Reset -->
                <Button Style="{StaticResource GhostButton}" Content="RESET" Command="{Binding ResetCommand}" Margin="0,0,8,0"/>
                <!-- Save Settings -->
                <Button Style="{StaticResource PrimaryButton}" Content="SAVE SETTINGS" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource LineBrush}"/>

        <!-- ══ Sections + content ═══════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="206"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <RadioButton x:Name="TabAuth" Style="{StaticResource SectionItem}" GroupName="SettingsTabs" IsChecked="True">
                    <DockPanel LastChildFill="False" Width="182">
                        <TextBlock DockPanel.Dock="Left" Text="Authentication" VerticalAlignment="Center"/>
                    </DockPanel>
                </RadioButton>
                <RadioButton x:Name="TabCodeSign" Style="{StaticResource SectionItem}" GroupName="SettingsTabs">
                    <DockPanel LastChildFill="False" Width="182">
                        <TextBlock DockPanel.Dock="Left" Text="Code Signing" VerticalAlignment="Center"/>
                    </DockPanel>
                </RadioButton>
                <RadioButton x:Name="TabNetworkPaths" Style="{StaticResource SectionItem}" GroupName="SettingsTabs">
                    <DockPanel LastChildFill="False" Width="182">
                        <TextBlock DockPanel.Dock="Left" Text="Network Paths" VerticalAlignment="Center"/>
                    </DockPanel>
                </RadioButton>
                <RadioButton x:Name="TabGroupAssignment" Style="{StaticResource SectionItem}" GroupName="SettingsTabs">
                    <DockPanel LastChildFill="False" Width="182">
                        <TextBlock DockPanel.Dock="Left" Text="Group Assignment" VerticalAlignment="Center"/>
                    </DockPanel>
                </RadioButton>
                <RadioButton x:Name="TabIntuneDefaults" Style="{StaticResource SectionItem}" GroupName="SettingsTabs">
                    <DockPanel LastChildFill="False" Width="182">
                        <TextBlock DockPanel.Dock="Left" Text="Intune Defaults" VerticalAlignment="Center"/>
                    </DockPanel>
                </RadioButton>
                <RadioButton x:Name="TabAppearance" Style="{StaticResource SectionItem}" GroupName="SettingsTabs">
                    <DockPanel LastChildFill="False" Width="182">
                        <TextBlock DockPanel.Dock="Left" Text="Appearance" VerticalAlignment="Center"/>
                    </DockPanel>
                </RadioButton>
                <!-- Planned sections -->
                <RadioButton Style="{StaticResource SectionItem}" GroupName="SettingsTabs" IsEnabled="False">
                    <DockPanel LastChildFill="False" Width="182">
                        <TextBlock DockPanel.Dock="Left" Text="WDAC Hyper-V" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="SOON" VerticalAlignment="Center"
                                   FontFamily="{StaticResource LabelFontFamily}" FontSize="10" FontWeight="Medium"
                                   Foreground="{DynamicResource Dim2Brush}"/>
                    </DockPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SectionItem}" GroupName="SettingsTabs" IsEnabled="False">
                    <DockPanel LastChildFill="False" Width="182">
                        <TextBlock DockPanel.Dock="Left" Text="GitLab" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="SOON" VerticalAlignment="Center"
                                   FontFamily="{StaticResource LabelFontFamily}" FontSize="10" FontWeight="Medium"
                                   Foreground="{DynamicResource Dim2Brush}"/>
                    </DockPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SectionItem}" GroupName="SettingsTabs" IsEnabled="False">
                    <DockPanel LastChildFill="False" Width="182">
                        <TextBlock DockPanel.Dock="Left" Text="Key Vault Caching" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="SOON" VerticalAlignment="Center"
                                   FontFamily="{StaticResource LabelFontFamily}" FontSize="10" FontWeight="Medium"
                                   Foreground="{DynamicResource Dim2Brush}"/>
                    </DockPanel>
                </RadioButton>

        <!-- ══ First-run setup banner ═══════════════════════════════════ -->
        <Border x:Name="FirstRunBanner" Background="{DynamicResource WarnSoftBrush}"
                BorderBrush="{DynamicResource WarnBrush}" BorderThickness="2,0,0,0"
                Padding="12,11" Margin="0,16,0,0" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconBulb}" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Viewbox>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5">
                    <Run Text="First-run setup" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                    <Run Text="  Complete authentication and network paths, then save. This hint is cleared automatically once configuration is valid."
                         Foreground="{DynamicResource MutedBrush}"/>
                </TextBlock>
                <Button Grid.Column="2" Style="{StaticResource RowIconButton}" Click="DismissFirstRun_Click"
                        VerticalAlignment="Center" ToolTip="Dismiss">
                    <Viewbox Width="12" Height="12">
                        <Path Data="{StaticResource IconX}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>
            </StackPanel>

        <!-- ══ Tab content ══════════════════════════════════════════════ -->
        <ScrollViewer Grid.Column="2" Margin="0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Authentication card -->
                    <Border Background="Transparent" BorderThickness="0" Padding="0"
                            Visibility="{Binding IsChecked, ElementName=TabAuth, Converter={StaticResource BoolToVis}}">
                        <StackPanel>

                            <!-- Card header -->
<StackPanel Margin="0,0,0,14">
    <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="AUTHENTICATION" Style="{StaticResource SectionLabel}"/>
        <Border Style="{StaticResource Rule}" Margin="12,0,0,0"/>
    </DockPanel>
    <TextBlock Text="How EPS connects to Microsoft Intune &amp; Entra ID" Style="{StaticResource SubText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
</StackPanel>

                            <!-- Auth mode tab bar (Interactive | App Registration) -->
                            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="4">
                                <UniformGrid Rows="1">
                                    <RadioButton Style="{StaticResource ModeToggle}" GroupName="AuthModeGroup"
                                                 IsChecked="{Binding IsInteractive}">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="14" Height="14">
                                                <Path Data="{StaticResource IconUser}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Viewbox>
                                            <TextBlock Text="Interactive" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource ModeToggle}" GroupName="AuthModeGroup" Margin="4,0,0,0"
                                                 IsChecked="{Binding IsAppRegistration}">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="14" Height="14">
                                                <Path Data="{StaticResource IconShield}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Viewbox>
                                            <TextBlock Text="App Registration" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                            </Border>

                            <!-- Interactive panel -->
                            <StackPanel Margin="0,18,0,0"
                                        Visibility="{Binding IsInteractive, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Tenant ID" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="optional" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,2" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                                <Grid Margin="0,7,0,0">
                                    <TextBox AutomationProperties.Name="Tenant ID" Style="{StaticResource TextField}"
                                             Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}"
                                             local:PlaceholderText.Text="contoso.onmicrosoft.com or tenant GUID"/>
                                </Grid>

                                <!-- Browser sign-in row -->
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="16,14" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="4" Background="{DynamicResource PrimaryDimBrush}" Margin="0,0,14,0">
                                            <Viewbox Width="16" Height="16">
                                                <Path Data="{StaticResource IconGrid}" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Browser sign-in" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                            <TextBlock Text="You'll be redirected to Microsoft to authenticate" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <!-- Not signed in status -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                                                    Visibility="{Binding IsNotSignedIn, Converter={StaticResource BoolToVis}}">
                                            <Rectangle Width="6" Height="6" RadiusX="3" RadiusY="3" Fill="{DynamicResource MarkBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Not signed in" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <!-- Signed in status -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                                                    Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
                                            <Rectangle Width="6" Height="6" RadiusX="3" RadiusY="3" Fill="{DynamicResource OkBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding SignedInUser}" FontSize="12.5" Foreground="{DynamicResource OkBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <!-- Sign in button -->
                                        <Button Grid.Column="3" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding SignInCommand}"
                                                Visibility="{Binding IsNotSignedIn, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                                    <Path Data="{StaticResource IconChevR}" Stroke="{DynamicResource PrimaryFgBrush}" StrokeThickness="2.2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Viewbox>
                                                <TextBlock Text="Sign in" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- Sign out button -->
                                        <Button Grid.Column="3" Style="{StaticResource GhostButton}"
                                                Command="{Binding SignOutCommand}"
                                                Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Sign out" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- App Registration panel -->
                            <StackPanel Margin="0,18,0,0"
                                        Visibility="{Binding IsAppRegistration, Converter={StaticResource BoolToVis}}">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Tenant ID -->
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Tenant ID" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock Text=" *" Foreground="{DynamicResource AccentTextBrush}" FontSize="12.5" FontWeight="Bold"/>
                                        </StackPanel>
                                        <Grid Margin="0,7,0,0">
                                            <TextBox AutomationProperties.Name="Tenant ID" Style="{StaticResource TextField}"
                                                     Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}"
                                                     local:PlaceholderText.Text="00000000-0000-0000-0000-000000000000"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Application (Client) ID -->
                                    <StackPanel Grid.Column="2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Application (Client) ID" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock Text=" *" Foreground="{DynamicResource AccentTextBrush}" FontSize="12.5" FontWeight="Bold"/>
                                        </StackPanel>
                                        <Grid Margin="0,7,0,0">
                                            <TextBox AutomationProperties.Name="Application (Client) ID" Style="{StaticResource TextField}"
                                                     Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"
                                                     local:PlaceholderText.Text="Application (Client) ID"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- Certificate source -->
                                <TextBlock Text="Certificate" Style="{StaticResource FieldLabel}" Margin="0,18,0,7"/>
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="4" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="AuthCertSource"
                                                     IsChecked="{Binding AuthUseStoreCert}">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="13" Height="13">
                                                    <Path Data="{StaticResource IconBook}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Viewbox>
                                                <TextBlock Text="Select from store" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="AuthCertSource" Margin="3,0,0,0"
                                                     IsChecked="{Binding AuthUseManualThumbprint}">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="13" Height="13">
                                                    <Path Data="{StaticResource IconCode}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Viewbox>
                                                <TextBlock Text="Enter thumbprint" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>

                                <!-- Store cert picker -->
                                <ComboBox AutomationProperties.Name="Certificate" Margin="0,10,0,0"
                                          ItemsSource="{Binding AvailableCertificates}"
                                          SelectedItem="{Binding SelectedAuthCert}"
                                          Visibility="{Binding AuthUseStoreCert, Converter={StaticResource BoolToVis}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Thumbprint}" FontSize="11" Foreground="{DynamicResource MutedBrush}" FontFamily="{StaticResource MonoFontFamily}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Manual thumbprint -->
                                <Grid Margin="0,10,0,0"
                                      Visibility="{Binding AuthUseManualThumbprint, Converter={StaticResource BoolToVis}}">
                                    <TextBox Style="{StaticResource TextField}" FontFamily="{StaticResource MonoFontFamily}"
                                             Text="{Binding AuthThumbprint, UpdateSourceTrigger=PropertyChanged}"
                                             local:PlaceholderText.Text="40-char SHA-1 thumbprint"/>
                                </Grid>

                                <TextBlock FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap">
                                    <Run Text="Certificate must be installed in the"/>
                                    <Run Text=" CurrentUser\My " FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextBrush}"/>
                                    <Run Text="store on this machine."/>
                                </TextBlock>

                            </StackPanel>

                            <!-- Connection test (both auth modes) -->
                            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,14" Margin="0,16,0,0">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock Text="Connection test" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                            <TextBlock Text="Verify the sign-in reaches Intune and the required Graph scopes are consented"
                                                       FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                                Command="{Binding TestConnectionCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                                    <Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Viewbox>
                                                <TextBlock Text="Test connection" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Per-scope results -->
                                    <ItemsControl ItemsSource="{Binding ConnectionChecks}" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                        <Rectangle Width="6" Height="6" RadiusX="3" RadiusY="3" VerticalAlignment="Center" Margin="0,0,9,0">
                                                            <Rectangle.Style>
                                                                <Style TargetType="Rectangle">
                                                                    <Setter Property="Fill" Value="{DynamicResource BadBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Ok}" Value="True">
                                                                            <Setter Property="Fill" Value="{DynamicResource OkBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Rectangle.Style>
                                                        </Rectangle>
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Detail}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Summary -->
                                    <TextBlock Text="{Binding ConnectionStatus}" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding HasConnectionStatus, Converter={StaticResource BoolToVis}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ConnectionOk}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>

                    <!-- Appearance card -->
                    <Border Background="Transparent" BorderThickness="0" Padding="0"
                            Visibility="{Binding IsChecked, ElementName=TabAppearance, Converter={StaticResource BoolToVis}}">
                        <StackPanel>

                            <!-- Card header -->
                            <StackPanel Margin="0,0,0,14">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="APPEARANCE" Style="{StaticResource SectionLabel}"/>
                                    <Border Style="{StaticResource Rule}" Margin="12,0,0,0"/>
                                </DockPanel>
                                <TextBlock Text="How Packman looks on this machine" Style="{StaticResource SubText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Theme (System | Dark | Light) -->
                            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="4" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource ModeToggle}" GroupName="ThemeGroup"
                                                 Content="System" IsChecked="{Binding IsThemeSystem}"/>
                                    <RadioButton Style="{StaticResource ModeToggle}" GroupName="ThemeGroup"
                                                 Content="Dark" IsChecked="{Binding IsThemeDark}"/>
                                    <RadioButton Style="{StaticResource ModeToggle}" GroupName="ThemeGroup"
                                                 Content="Light" IsChecked="{Binding IsThemeLight}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Applies straight away and is remembered. System follows the Windows app-theme setting. Both palettes share one set of tokens, so every surface, de-emphasis step and status colour keeps its role — and each text tone clears WCAG AA against its panel."
                                       Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,14,0,0" MaxWidth="560" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- Code Signing card -->
                    <Border Background="Transparent" BorderThickness="0" Padding="0"
                            Visibility="{Binding IsChecked, ElementName=TabCodeSign, Converter={StaticResource BoolToVis}}">
                        <StackPanel>

                            <!-- Card header -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="4" Background="{DynamicResource PrimaryDimBrush}">
                                    <Viewbox Width="20" Height="20">
                                        <Path Data="{StaticResource IconShield}" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Code Signing" Style="{StaticResource H2}"/>
                                    <TextBlock Text="Authenticode certificate used to sign packaged applications" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <!-- Enable / Disable toggle -->
                                <Border Grid.Column="2" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="CodeSignEnable"
                                                     IsChecked="{Binding CodeSigningDisabled}">
                                            <TextBlock Text="Disabled" VerticalAlignment="Center"/>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="CodeSignEnable" Margin="3,0,0,0"
                                                     IsChecked="{Binding CodeSigningEnabled}">
                                            <TextBlock Text="Enabled" VerticalAlignment="Center"/>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Disabled placeholder -->
                            <TextBlock Visibility="{Binding CodeSigningDisabled, Converter={StaticResource BoolToVis}}"
                                       FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                                       Text="Code signing is disabled. Packages will not be Authenticode-signed."/>

                            <!-- Enabled: cert source + fields -->
                            <StackPanel Visibility="{Binding CodeSigningEnabled, Converter={StaticResource BoolToVis}}">

                                <!-- Cert source toggle -->
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="CodeSignCertSource"
                                                     IsChecked="{Binding CodeSignUseStoreCert}">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="13" Height="13">
                                                    <Path Data="{StaticResource IconBook}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Viewbox>
                                                <TextBlock Text="Select from store" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="CodeSignCertSource" Margin="3,0,0,0"
                                                     IsChecked="{Binding CodeSignUseManualThumbprint}">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="13" Height="13">
                                                    <Path Data="{StaticResource IconCode}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Viewbox>
                                                <TextBlock Text="Enter manually" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>


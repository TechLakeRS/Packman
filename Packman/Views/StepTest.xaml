<UserControl x:Class="Packman.Views.StepTest"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Packman.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="{StaticResource UIFontFamily}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Target device + actions -->
        <StackPanel Grid.Column="0">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <controls:SectionHeader Title="Package" Caption="{Binding PackageSourceCaption}" Margin="0,0,0,14"/>

                    <StackPanel Visibility="{Binding HasPackage, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding PackageLabel}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding PackagePath}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                                   FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource DimBrush}"/>
                    </StackPanel>

                    <TextBlock Text="No package selected. Generate one on the Package step and it lands here automatically, or browse to a package already built on the share."
                               FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource Muted2Brush}"
                               Visibility="{Binding NeedsPackage, Converter={StaticResource BoolToVis}}"/>

                    <Button Style="{StaticResource GhostButton}" Content="Browse for package…" HorizontalAlignment="Stretch"
                            Margin="0,12,0,0" Click="BrowsePackage_Click" IsEnabled="{Binding IsIdle}"
                            ToolTip="Pick a PSADT package folder on the share to test."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <controls:SectionHeader Title="Target device" Margin="0,0,0,14"/>

                    <TextBlock Text="Use a test device with WinRM enabled and admin-share access. User context also needs a signed-in user."
                        Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <TextBlock Text="Computer name" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" IsEditable="True" FontSize="13"
                                  ItemsSource="{Binding RecentComputers}"
                                  Text="{Binding TargetComputer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding IsIdle}"
                                  ToolTip="Name of the machine to test on. WinRM must be enabled (Enable-PSRemoting)."/>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Ping" Margin="8,0,0,0"
                                Command="{Binding CheckOnlineCommand}"/>
                    </Grid>

                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="Run context" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
                    <Border Style="{StaticResource SegmentGroup}" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource ContextToggle}" Content="System"
                                         IsChecked="{Binding IsSystemContext, Mode=TwoWay}" IsEnabled="{Binding IsIdle}"/>
                            <RadioButton Style="{StaticResource ContextToggle}" Content="User"
                                         IsChecked="{Binding RunAsUser, Mode=TwoWay}" IsEnabled="{Binding IsIdle}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding ContextHelpText}" Margin="0,9,0,0" FontSize="12" LineHeight="18"
                               TextWrapping="Wrap" Foreground="{DynamicResource Muted2Brush}"/>

                    <CheckBox Content="Delete the staged package from the target after the run"
                              Margin="0,16,0,0" FontSize="12"
                              IsChecked="{Binding CleanupAfterRun, Mode=TwoWay}" IsEnabled="{Binding IsIdle}"
                              AutomationProperties.Name="Delete the staged package from the target after the run"
                              ToolTip="Off by default, so a re-run only copies the files that changed."/>
                </StackPanel>
            </Border>

            <!-- Detection rule discovered on the target -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0"
                    Visibility="{Binding HasDiscoveredRule, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <controls:SectionHeader Title="Detection rule" Caption="found on the target" Margin="0,0,0,14"/>
                    <TextBlock Text="{Binding DiscoveredSummary}" FontSize="12.5" TextWrapping="Wrap"
                               FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource InkBrush}"/>

                    <!-- Only the wizard has a publish step to hand the rule to. -->
                    <StackPanel Visibility="{Binding HasPublishStep, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource GhostButton}" Content="Use for publishing" HorizontalAlignment="Left"
                                Margin="0,12,0,0" Command="{Binding ApplyDetectionCommand}"
                                ToolTip="Replace the publish step's detection rule with this one."/>
                        <TextBlock Text="The publish step holds the wizard's own package, so a package picked from the share cannot feed it."
                                   Margin="0,8,0,0" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Muted2Brush}"
                                   Visibility="{Binding IsSelectedPackage, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Actions stay beside device setup, above the live output. -->
        <StackPanel Grid.Column="2">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <controls:SectionHeader Title="Test actions" Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource PrimaryButton}" Content="Run install" HorizontalAlignment="Stretch"
                                Command="{Binding InstallCommand}"/>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Run uninstall" HorizontalAlignment="Stretch"
                                Command="{Binding UninstallCommand}"/>
                    </Grid>
                    <Button Style="{StaticResource GhostButton}" Content="Discover detection rule" HorizontalAlignment="Stretch"
                            Margin="0,8,0,0" Command="{Binding DetectCommand}"
                            ToolTip="Search the target for the installed executable and build a detection rule from it."/>

                    <StackPanel Margin="0,14,0,0" Visibility="{Binding IsCopying, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Caption}">
                            <Run Text="copying package —"/><Run Text=" "/><Run Text="{Binding CopyPercent, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>
                        <ProgressBar Height="4" Margin="0,6,0,0" Minimum="0" Maximum="100"
                                     Value="{Binding CopyPercent, Mode=OneWay}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock DockPanel.Dock="Left" Text="Live output" Style="{StaticResource SectionLabel}"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Content="Clear"
                            Command="{Binding ClearLogCommand}"/>
                    <Border Style="{StaticResource Rule}"/>
                </DockPanel>

                <Border Background="{DynamicResource CodeBgBrush}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="14,12" MinHeight="380" MaxHeight="600">
                    <ScrollViewer x:Name="ConsoleScroll" MinHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="12" LineHeight="20"
                                               LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap">
                                        <Run Foreground="{DynamicResource CodeCommentBrush}" Text="{Binding Time, Mode=OneWay}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding Text, Mode=OneWay}">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Setter Property="Foreground" Value="{DynamicResource CodeTxtBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Good">
                                                            <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Warn">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Bad">
                                                            <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Dim">
                                                            <Setter Property="Foreground" Value="{DynamicResource CodeCommentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Border>
        </StackPanel>
    </Grid>
</UserControl>

<UserControl x:Class="Packman.Views.RemoteTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Packman.Views"
             xmlns:vm="clr-namespace:Packman.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RemoteTestViewModel}"
             FontFamily="{StaticResource UIFontFamily}">

    <Grid Margin="26,20,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Remote Test" Style="{StaticResource H1}"/>
            <TextBlock Text="Deploy a package built earlier to a test machine and watch the result"
                       Style="{StaticResource SubText}" Margin="0,5,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,22,0,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <views:StepTest/>
        </ScrollViewer>
    </Grid>
</UserControl>

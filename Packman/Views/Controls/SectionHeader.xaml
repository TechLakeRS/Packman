<UserControl x:Class="Packman.Views.Controls.SectionHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root">
    <StackPanel>
        <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource H2}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Caption, ElementName=Root}" Margin="0,5,0,0" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource SubText}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Caption, ElementName=Root}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        <DataTrigger Binding="{Binding Caption, ElementName=Root}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>

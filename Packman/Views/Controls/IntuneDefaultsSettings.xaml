<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Packman" xmlns:controls="clr-namespace:Packman.Views.Controls" x:Class="Packman.Views.Controls.IntuneDefaultsSettings">
    <Border Background="Transparent" BorderThickness="0" Padding="0">
        <StackPanel>
            <!-- Card header -->
            <StackPanel Margin="0,0,0,14">
                <controls:SectionHeader Title="Intune defaults"/>
                <TextBlock Text="App details, requirements and return codes applied to every package unless changed on the Create Package page" Style="{StaticResource SubText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <!-- ── App details ────────────────────────────────── -->
            <TextBlock Text="App details" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
            <TextBlock Text="Sent with every Win32 app created in Intune" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,12"/>
            <TextBlock Text="App title template" Style="{StaticResource FieldLabel}"/>
            <TextBox AutomationProperties.Name="App title template" Style="{StaticResource TextField}" Margin="0,7,0,0" FontFamily="{StaticResource MonoFontFamily}" Text="{Binding DisplayNameTemplate, UpdateSourceTrigger=PropertyChanged}" local:PlaceholderText.Text="%vendor% %appName% %appVersion%"/>
            <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap">
                <Run Text="Tokens:"/>
                <Run Text=" %vendor% " FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextBrush}"/>
                <Run Text="%appName% " FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextBrush}"/>
                <Run Text="%appVersion%" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextBrush}"/>
                <Run Text="  ·  Still editable per upload."/>
                <LineBreak/>
                <Run Text="Example: "/>
                <Run Text="{Binding DisplayNamePreview, Mode=OneWay}" Foreground="{DynamicResource AccentTextBrush}" FontFamily="{StaticResource MonoFontFamily}"/>
            </TextBlock>
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Install command" Style="{StaticResource FieldLabel}"/>
                    <TextBox AutomationProperties.Name="Install command" Style="{StaticResource TextField}" Margin="0,7,0,0" FontFamily="{StaticResource MonoFontFamily}" local:PlaceholderText.Text="Invoke-AppDeployToolkit.exe Install" Text="{Binding DefaultInstallCommand, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Uninstall command" Style="{StaticResource FieldLabel}"/>
                    <TextBox AutomationProperties.Name="Uninstall command" Style="{StaticResource TextField}" Margin="0,7,0,0" FontFamily="{StaticResource MonoFontFamily}" local:PlaceholderText.Text="Invoke-AppDeployToolkit.exe Uninstall" Text="{Binding DefaultUninstallCommand, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Privacy URL" Style="{StaticResource FieldLabel}"/>
                    <TextBox AutomationProperties.Name="Privacy URL" Style="{StaticResource TextField}" Margin="0,7,0,0" local:PlaceholderText.Text="https://contoso.com/privacy" Text="{Binding DefaultPrivacyUrl, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Information URL" Style="{StaticResource FieldLabel}"/>
                    <TextBox AutomationProperties.Name="Information URL" Style="{StaticResource TextField}" Margin="0,7,0,0" local:PlaceholderText.Text="https://contoso.com/apps" Text="{Binding DefaultInformationUrl, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
            <!-- Divider -->
            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,18,0,18"/>
            <!-- ── Device requirements ────────────────────────── -->
            <TextBlock Text="Device requirements" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
            <TextBlock Text="Leave a field blank for no constraint" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,12"/>
            <TextBlock Text="Minimum operating system" Style="{StaticResource FieldLabel}"/>
            <ComboBox AutomationProperties.Name="Minimum operating system" Margin="0,7,0,0" Height="42" VerticalContentAlignment="Center" ItemsSource="{Binding OperatingSystems}" SelectedItem="{Binding DefaultOperatingSystem, Mode=TwoWay}"/>
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Minimum free disk space (MB)" Style="{StaticResource FieldLabel}"/>
                    <TextBox AutomationProperties.Name="Minimum free disk space (MB)" Style="{StaticResource TextField}" Margin="0,7,0,0" local:PlaceholderText.Text="any" Text="{Binding DefaultMinFreeDiskSpaceMB, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Minimum memory (MB)" Style="{StaticResource FieldLabel}"/>
                    <TextBox AutomationProperties.Name="Minimum memory (MB)" Style="{StaticResource TextField}" Margin="0,7,0,0" local:PlaceholderText.Text="any" Text="{Binding DefaultMinMemoryMB, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Minimum number of processors" Style="{StaticResource FieldLabel}"/>
                    <TextBox AutomationProperties.Name="Minimum number of processors" Style="{StaticResource TextField}" Margin="0,7,0,0" local:PlaceholderText.Text="any" Text="{Binding DefaultMinProcessors, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Minimum CPU speed (MHz)" Style="{StaticResource FieldLabel}"/>
                    <TextBox AutomationProperties.Name="Minimum CPU speed (MHz)" Style="{StaticResource TextField}" Margin="0,7,0,0" local:PlaceholderText.Text="any" Text="{Binding DefaultMinCpuSpeedMHz, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
            <!-- Divider -->
            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,18,0,18"/>
            <!-- ── Return codes ───────────────────────────────── -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="Return codes" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                    <TextBlock Text="How Intune interprets the installer exit codes" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding RestoreDefaultReturnCodesCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                            <Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Style="{StaticResource Icon}"/>
                        </Viewbox>
                        <TextBlock Text="Restore standard codes" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
            <!-- Add return code row -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource TextField}" FontFamily="{StaticResource MonoFontFamily}" Text="{Binding NewReturnCodeInput, UpdateSourceTrigger=PropertyChanged}" local:PlaceholderText.Text="Exit code, e.g. 1707"/>
                    <TextBox Grid.Column="2" Style="{StaticResource TextField}" Text="{Binding NewReturnCodeDescription, UpdateSourceTrigger=PropertyChanged}" local:PlaceholderText.Text="Description (optional)"/>
                </Grid>
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding AddReturnCodeCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                            <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Style="{StaticResource Icon}"/>
                        </Viewbox>
                        <TextBlock Text="Add" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
            <!-- Return code rows -->
            <controls:ReturnCodeEditor Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</UserControl>

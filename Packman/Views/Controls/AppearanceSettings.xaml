<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Packman" xmlns:controls="clr-namespace:Packman.Views.Controls" x:Class="Packman.Views.Controls.AppearanceSettings">
    <Border Background="Transparent" BorderThickness="0" Padding="0">
        <StackPanel>
            <!-- Card header -->
            <StackPanel Margin="0,0,0,14">
                <controls:SectionHeader Title="Appearance"/>
                <TextBlock Text="How Packman looks on this machine" Style="{StaticResource SubText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <!-- Theme (System | Dark | Light) -->
            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="4" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource ModeToggle}" GroupName="ThemeGroup" Content="System" IsChecked="{Binding IsThemeSystem}"/>
                    <RadioButton Style="{StaticResource ModeToggle}" GroupName="ThemeGroup" Content="Dark" IsChecked="{Binding IsThemeDark}"/>
                    <RadioButton Style="{StaticResource ModeToggle}" GroupName="ThemeGroup" Content="Light" IsChecked="{Binding IsThemeLight}"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Applies immediately and is saved automatically. System follows your Windows appearance setting." Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,14,0,0" MaxWidth="560" HorizontalAlignment="Left"/>
        </StackPanel>
    </Border>
</UserControl>

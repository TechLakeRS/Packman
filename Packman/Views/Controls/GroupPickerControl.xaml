<UserControl x:Class="Packman.Views.Controls.GroupPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Packman"
             xmlns:vm="clr-namespace:Packman.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GroupPickerViewModel}">
    <!-- DataContext is a GroupPickerViewModel. Intent toggle, Entra group search,
         result rows and the selected chips. -->
    <StackPanel>
        <TextBlock Text="Assignment type" Style="{StaticResource FieldLabel}" Margin="0,0,0,7"/>
        <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                Padding="4" HorizontalAlignment="Left" CornerRadius="4">
            <!-- No GroupName: the buttons group by their panel, so two pickers in one window stay independent. -->
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource ContextToggle}" Content="Required"
                             IsChecked="{Binding Intent, Mode=TwoWay, Converter={StaticResource StringMatch}, ConverterParameter=required}"/>
                <RadioButton Style="{StaticResource ContextToggle}" Content="Available" Margin="3,0,0,0"
                             IsChecked="{Binding Intent, Mode=TwoWay, Converter={StaticResource StringMatch}, ConverterParameter=available}"/>
                <RadioButton Style="{StaticResource ContextToggle}" Content="Uninstall" Margin="3,0,0,0"
                             IsChecked="{Binding Intent, Mode=TwoWay, Converter={StaticResource StringMatch}, ConverterParameter=uninstall}"/>
            </StackPanel>
        </Border>

        <TextBlock Text="Assignment groups" Style="{StaticResource FieldLabel}" Margin="0,16,0,7"/>
        <Grid>
            <TextBox AutomationProperties.Name="Assignment groups" Style="{StaticResource TextField}" Padding="11,0,92,0"
                     local:PlaceholderText.Text="Search Entra groups…"
                     Text="{Binding GroupQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchGroupsCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Style="{StaticResource MiniButton}" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Margin="0,2,2,2" Command="{Binding SearchGroupsCommand}">
                <TextBlock Text="Search" VerticalAlignment="Center"/>
            </Button>
        </Grid>

        <TextBlock Text="{Binding GroupSearchHint}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding GroupSearchHint}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Search results -->
        <ItemsControl ItemsSource="{Binding GroupResults}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button FocusVisualStyle="{StaticResource FocusVisual}" AutomationProperties.Name="{Binding DisplayName}" HorizontalContentAlignment="Stretch" Margin="0,0,0,6" Cursor="Hand"
                            Command="{Binding DataContext.AddGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="12,9" CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,9,0">
                                            <Path Data="{StaticResource IconGroup}" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.8" Style="{StaticResource Icon}"/>
                                        </Viewbox>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12.5" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Each row keeps its own assignment intent. -->
        <ItemsControl ItemsSource="{Binding SelectedGroups}" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding GroupName}" Style="{StaticResource SubText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Grid.Column="2" Style="{StaticResource RowIconButton}" Content="×" ToolTip="Remove assignment"
                                Command="{Binding DataContext.RemoveGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Margin="0,4,0,0" FontSize="12.5" Foreground="{DynamicResource MutedBrush}">
            <Run Text="Next group is added as "/>
            <Run Text="{Binding IntentLabel, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
            <Run Text="."/>
        </TextBlock>
    </StackPanel>
</UserControl>

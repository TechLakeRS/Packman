<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Packman" xmlns:controls="clr-namespace:Packman.Views.Controls" x:Class="Packman.Views.Controls.GroupAssignmentSettings">
    <Border Background="Transparent" BorderThickness="0" Padding="0">
        <StackPanel>
            <!-- Card header -->
            <StackPanel Margin="0,0,0,14">
                <controls:SectionHeader Title="Group assignment"/>
                <TextBlock Text="Assign uploaded packages to Entra ID groups automatically" Style="{StaticResource SubText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <!-- ── Per-package group ──────────────────────────── -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Create an install group for each package" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                    <TextBlock Text="A security group is created (or reused if it already exists) on upload and assigned to the app" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <!-- On / Off toggle -->
                <Border Grid.Column="1" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="GroupPerPackage" IsChecked="{Binding CreateGroupPerPackageDisabled}">
                            <TextBlock Text="Off" VerticalAlignment="Center"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="GroupPerPackage" Margin="3,0,0,0" IsChecked="{Binding CreateGroupPerPackage}">
                            <TextBlock Text="On" VerticalAlignment="Center"/>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- Naming template + intent (only when On) -->
            <StackPanel Visibility="{Binding CreateGroupPerPackage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Install group name template" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,7,0,0">
                    <TextBox AutomationProperties.Name="Install group name template" Style="{StaticResource TextField}" FontFamily="{StaticResource MonoFontFamily}" Text="{Binding GroupNameTemplate, UpdateSourceTrigger=PropertyChanged}" local:PlaceholderText.Text="%vendor%_%appName%_%appVersion%_Install"/>
                </Grid>
                <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap">
                    <Run Text="Tokens:"/>
                    <Run Text=" %vendor% " FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextBrush}"/>
                    <Run Text="%appName% " FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextBrush}"/>
                    <Run Text="%appVersion%" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextBrush}"/>
                    <Run Text="  ·  Mix in any literal text, e.g."/>
                    <Run Text=" %vendor%_%appName%_%appVersion%_Install" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextBrush}"/>
                    <LineBreak/>
                    <Run Text="Example: "/>
                    <Run Text="{Binding GroupNamePreview, Mode=OneWay}" Foreground="{DynamicResource AccentTextBrush}" FontFamily="{StaticResource MonoFontFamily}"/>
                </TextBlock>
                <!-- Assignment intent for the new group -->
                <TextBlock Text="Assignment type" Style="{StaticResource FieldLabel}" Margin="0,14,0,7"/>
                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="4" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="NewGroupIntent" IsChecked="{Binding NewGroupAvailable}">
                            <TextBlock Text="Available" VerticalAlignment="Center"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="NewGroupIntent" Margin="3,0,0,0" IsChecked="{Binding NewGroupRequired}">
                            <TextBlock Text="Required" VerticalAlignment="Center"/>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </StackPanel>
            <!-- Divider -->
            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,18,0,18"/>
            <!-- ── Per-package uninstall group ─────────────────── -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Create an uninstall group for each package" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                    <TextBlock Text="A second security group assigned with the Uninstall intent, so a device can be removed by group membership" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <!-- On / Off toggle -->
                <Border Grid.Column="1" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="UninstallGroupPerPackage" IsChecked="{Binding CreateUninstallGroupPerPackageDisabled}">
                            <TextBlock Text="Off" VerticalAlignment="Center"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="UninstallGroupPerPackage" Margin="3,0,0,0" IsChecked="{Binding CreateUninstallGroupPerPackage}">
                            <TextBlock Text="On" VerticalAlignment="Center"/>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </Grid>
            <StackPanel Visibility="{Binding CreateUninstallGroupPerPackage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Uninstall group name template" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,7,0,0">
                    <TextBox AutomationProperties.Name="Uninstall group name template" Style="{StaticResource TextField}" FontFamily="{StaticResource MonoFontFamily}" Text="{Binding UninstallGroupNameTemplate, UpdateSourceTrigger=PropertyChanged}" local:PlaceholderText.Text="%vendor%_%appName%_%appVersion%_Uninstall"/>
                </Grid>
                <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap">
                    <Run Text="Always assigned with the Uninstall intent."/>
                    <LineBreak/>
                    <Run Text="Example: "/>
                    <Run Text="{Binding UninstallGroupNamePreview, Mode=OneWay}" Foreground="{DynamicResource AccentTextBrush}" FontFamily="{StaticResource MonoFontFamily}"/>
                </TextBlock>
            </StackPanel>
            <!-- Divider -->
            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,18,0,18"/>
            <!-- ── Existing groups ────────────────────────────── -->
            <TextBlock Text="Always assign these existing groups" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
            <TextBlock Text="Every upload is also assigned to the groups listed below" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,12"/>
            <!-- Add group row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox AutomationProperties.Name="Group name to add" Style="{StaticResource TextField}" Text="{Binding NewGroupNameInput, UpdateSourceTrigger=PropertyChanged}" local:PlaceholderText.Text="Entra ID group display name"/>
                </Grid>
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding AddGroupCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                            <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Style="{StaticResource Icon}"/>
                        </Viewbox>
                        <TextBlock Text="Add" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
            <!-- Group rows -->
            <ItemsControl ItemsSource="{Binding ExistingGroups}" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding GroupName}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                                <!-- Intent toggle -->
                                <Border Grid.Column="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="3" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource ContextToggle}" IsChecked="{Binding IsAvailable}">
                                            <TextBlock Text="Available" VerticalAlignment="Center"/>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource ContextToggle}" Margin="3,0,0,0" IsChecked="{Binding IsRequired}">
                                            <TextBlock Text="Required" VerticalAlignment="Center"/>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource ContextToggle}" Margin="3,0,0,0" IsChecked="{Binding IsUninstall}">
                                            <TextBlock Text="Uninstall" VerticalAlignment="Center"/>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                                <!-- Remove -->
                                <Button Grid.Column="2" Style="{StaticResource RowIconButton}" Command="{Binding RemoveCommand}" VerticalAlignment="Center" ToolTip="Remove">
                                    <Viewbox Width="15" Height="15">
                                        <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Style="{StaticResource Icon}"/>
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>

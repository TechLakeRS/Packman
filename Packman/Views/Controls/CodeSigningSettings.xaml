<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Packman" xmlns:controls="clr-namespace:Packman.Views.Controls" x:Class="Packman.Views.Controls.CodeSigningSettings">
    <Border Background="Transparent" BorderThickness="0" Padding="0">
        <StackPanel>
            <!-- Card header -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="4" Background="{DynamicResource PrimaryDimBrush}">
                    <Viewbox Width="20" Height="20">
                        <Path Data="{StaticResource IconShield}" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.9" Style="{StaticResource Icon}"/>
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Code Signing" Style="{StaticResource H2}"/>
                    <TextBlock Text="Authenticode certificate used to sign packaged applications" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <!-- Enable / Disable toggle -->
                <Border Grid.Column="2" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="CodeSignEnable" IsChecked="{Binding CodeSigningDisabled}">
                            <TextBlock Text="Disabled" VerticalAlignment="Center"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="CodeSignEnable" Margin="3,0,0,0" IsChecked="{Binding CodeSigningEnabled}">
                            <TextBlock Text="Enabled" VerticalAlignment="Center"/>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- Disabled placeholder -->
            <TextBlock Visibility="{Binding CodeSigningDisabled, Converter={StaticResource BoolToVis}}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Text="Code signing is disabled. Packages will not be Authenticode-signed."/>
            <!-- Enabled: cert source + fields -->
            <StackPanel Visibility="{Binding CodeSigningEnabled, Converter={StaticResource BoolToVis}}">
                <!-- Cert source toggle -->
                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="CodeSignCertSource" IsChecked="{Binding CodeSignUseStoreCert}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13">
                                    <Path Data="{StaticResource IconBook}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Style="{StaticResource Icon}"/>
                                </Viewbox>
                                <TextBlock Text="Select from store" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="CodeSignCertSource" Margin="3,0,0,0" IsChecked="{Binding CodeSignUseManualThumbprint}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13">
                                    <Path Data="{StaticResource IconCode}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Style="{StaticResource Icon}"/>
                                </Viewbox>
                                <TextBlock Text="Enter manually" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <!-- Store picker -->
                <ComboBox AutomationProperties.Name="Certificate store" Margin="0,0,0,14" ItemsSource="{Binding AvailableCertificates}" SelectedItem="{Binding SelectedCodeSignCert}" Visibility="{Binding CodeSignUseStoreCert, Converter={StaticResource BoolToVis}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Thumbprint}" FontSize="12" Foreground="{DynamicResource MutedBrush}" FontFamily="{StaticResource MonoFontFamily}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <!-- Manual fields: Certificate Name + Subject + Thumbprint + Timestamp -->
                <Grid Visibility="{Binding CodeSignUseManualThumbprint, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Row 0: Name + Subject -->
                    <StackPanel Grid.Column="0" Grid.Row="0">
                        <TextBlock Text="Certificate Name" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,7,0,0">
                            <TextBox AutomationProperties.Name="Certificate Name" Style="{StaticResource TextField}" Text="{Binding CodeSignCertName, UpdateSourceTrigger=PropertyChanged}" local:PlaceholderText.Text="Friendly name"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="0">
                        <TextBlock Text="Certificate Subject" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,7,0,0">
                            <TextBox AutomationProperties.Name="Certificate Subject" Style="{StaticResource TextField}" Text="{Binding CodeSignCertSubject, UpdateSourceTrigger=PropertyChanged}" local:PlaceholderText.Text="CN=Company, O=..."/>
                        </Grid>
                    </StackPanel>
                    <!-- Row 2: Thumbprint + Timestamp -->
                    <StackPanel Grid.Column="0" Grid.Row="2">
                        <TextBlock Text="Certificate Thumbprint" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,7,0,0">
                            <TextBox AutomationProperties.Name="Certificate Thumbprint" Style="{StaticResource TextField}" FontFamily="{StaticResource MonoFontFamily}" Text="{Binding CodeSignThumbprint, UpdateSourceTrigger=PropertyChanged}" local:PlaceholderText.Text="SHA-1 thumbprint"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="2">
                        <TextBlock Text="Timestamp Server" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,7,0,0">
                            <TextBox AutomationProperties.Name="Timestamp Server" Style="{StaticResource TextField}" Text="{Binding CodeSignTimestampServer, UpdateSourceTrigger=PropertyChanged}" local:PlaceholderText.Text="http://timestamp.digicert.com"/>
                        </Grid>
                    </StackPanel>
                </Grid>
                <!-- Timestamp for store mode -->
                <StackPanel Margin="0,0,0,0" Visibility="{Binding CodeSignUseStoreCert, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Timestamp Server" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,7,0,0">
                        <TextBox AutomationProperties.Name="Timestamp Server" Style="{StaticResource TextField}" Text="{Binding CodeSignTimestampServer, UpdateSourceTrigger=PropertyChanged}" local:PlaceholderText.Text="http://timestamp.digicert.com"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

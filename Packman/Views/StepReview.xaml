<UserControl x:Class="Packman.Views.StepReview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Packman.Views.Controls"
    FontFamily="{StaticResource UIFontFamily}">
    <StackPanel>
        <StackPanel Visibility="{Binding Upload.Publish.IsNotPublishing, Converter={StaticResource BoolToVis}}">
            <controls:SectionHeader Title="Review your deployment" Caption="Confirm the package, destination and audience before publishing." Margin="0,0,0,20"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Destination tenant" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Upload.TenantName}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding ConnectionStatusText}" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Breadcrumb}" Content="Edit package" Command="{Binding GoToStepCommand}" CommandParameter="0"/>
                            <TextBlock Text="Package" Style="{StaticResource H2}"/>
                        </DockPanel>
                        <ContentControl Style="{StaticResource DlRow}" Tag="Name in Intune" Content="{Binding Upload.IntuneDisplayName}"/>
                        <ContentControl Style="{StaticResource DlRow}" Tag="Application" Content="{Binding Upload.ReviewName}"/>
                        <ContentControl Style="{StaticResource DlRow}" Tag="Publisher" Content="{Binding Upload.ReviewVendor}"/>
                        <ContentControl Style="{StaticResource DlRowMono}" Tag="Version" Content="{Binding Upload.ReviewVersion}"/>
                        <ContentControl Style="{StaticResource DlRow}" Tag="Author" Content="{Binding Upload.ReviewAuthor}"/>
                        <ContentControl Style="{StaticResource DlRow}" Tag="Architecture" Content="{Binding Upload.ReviewArchitecture}"/>
                        <ContentControl Style="{StaticResource DlRow}" Tag="Context" Content="{Binding Upload.ReviewContext}"/>
                        <ContentControl Style="{StaticResource DlRow}" Tag="Type" Content="{Binding Upload.ReviewPackageType}"/>
                        <ContentControl Style="{StaticResource DlRow}" Tag="Source size" Content="{Binding Upload.ReviewSize}"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Breadcrumb}" Content="Configure" Command="{Binding GoToStepCommand}" CommandParameter="1"/>
                                <TextBlock Text="Detection &amp; audience" Style="{StaticResource H2}"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Upload.DetectionSummary}" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                            <ItemsControl ItemsSource="{Binding Upload.GroupPicker.SelectedGroups}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <TextBlock Text="{Binding ChipText}" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No existing groups selected." Style="{StaticResource SubText}" TextWrapping="Wrap"
                                Visibility="{Binding Upload.GroupPicker.HasGroups, Converter={StaticResource InverseBoolToVis}}"/>
                            <TextBlock Text="{Binding Upload.PerPackageGroupsSummary}" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Verify before rollout" Style="{StaticResource H2}"/>
                            <TextBlock Text="Test install and uninstall on a representative device. Check the detection rule against the installed application." Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,8,0,14"/>
                            <Button Style="{StaticResource GhostButton}" Content="Open remote test" Command="{Binding OpenTestToolCommand}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Installation behavior" Style="{StaticResource H2}" Margin="0,0,0,14"/>
                    <ContentControl Style="{StaticResource DlRow}" Tag="Deploy mode" Content="{Binding Upload.SelectedDeployMode}"/>
                    <ContentControl Style="{StaticResource DlRowMono}" Tag="Install" Content="{Binding Upload.InstallCommandPreview}"/>
                    <ContentControl Style="{StaticResource DlRowMono}" Tag="Uninstall" Content="{Binding Upload.UninstallCommandPreview}"/>
                    <ContentControl Style="{StaticResource DlRow}" Tag="Minimum OS" Content="{Binding Upload.SelectedOperatingSystem}"/>
                    <TextBlock Text="Intune deployment must complete without user input. Package files and script syntax are checked before signing and building." Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                    <Expander Header="Requirements &amp; return codes" Margin="0,16,0,0">
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="{Binding Upload.RequirementsSummary}" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding Upload.ReturnCodes}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <ContentControl Style="{StaticResource DlRow}" Tag="{Binding Code}" Content="{Binding Type}"/>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding Upload.StatusText}" Foreground="{DynamicResource WarnBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,18,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <controls:PublishStatusControl DataContext="{Binding Upload.Publish}" Visibility="{Binding IsPublishing, Converter={StaticResource BoolToVis}}"/>
    </StackPanel>
</UserControl>

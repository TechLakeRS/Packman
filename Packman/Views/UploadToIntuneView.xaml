<UserControl x:Class="Packman.Views.UploadToIntuneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Packman"
             mc:Ignorable="d"
             FontFamily="{StaticResource UIFontFamily}">

    <Grid>
        <!-- ============ FORM ============ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding Publish.IsNotPublishing, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="26,20,26,26">
                <StackPanel>
                    <TextBlock Text="Upload to Intune" Style="{StaticResource H1}"/>
                    <TextBlock Text="Publish an already-built package without re-creating it" Style="{StaticResource SubText}" Margin="0,5,0,0"/>
                </StackPanel>

                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN -->
                    <StackPanel Grid.Column="0">

                        <!-- Select Package card -->
                        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
<StackPanel Margin="0,0,0,14">
    <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="SELECT PACKAGE" Style="{StaticResource SectionLabel}"/>
        <Border Style="{StaticResource Rule}" Margin="12,0,0,0"/>
    </DockPanel>
    <TextBlock Text="Choose the folder that contains the Invoke-AppDeployToolkit package" Style="{StaticResource SubText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
</StackPanel>

                                <!-- Folder picker row -->
                                <Grid>
                                    <TextBox Style="{StaticResource TextField}" Padding="11,0,86,0" IsReadOnly="True"
                                             local:PlaceholderText.Text="Select the package folder (contains the Application folder)"
                                             Text="{Binding PackageRoot, Mode=OneWay}"/>
                                    <Button Style="{StaticResource BrowseButton}" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                            Margin="0,6,6,6" Click="Browse_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="15" Height="15">
                                                <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Viewbox>
                                            <TextBlock Text="Browse" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Validation error -->
                                <Border Background="{DynamicResource BadSoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,12,0,0"
                                        Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ValidationError}" FontSize="12.5" Foreground="{DynamicResource BadBrush}" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Validated metadata -->
                                <StackPanel Visibility="{Binding IsValidated, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
                                    <Border Background="{DynamicResource OkSoftBrush}" CornerRadius="4" Padding="12,10">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="15" Height="15">
                                                <Path Data="{StaticResource IconCheck}" Stroke="{DynamicResource OkBrush}" StrokeThickness="2.6" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Viewbox>
                                            <TextBlock Text="Package validated — metadata detected" Margin="9,0,0,0" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource OkBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Margin="2,12,2,0">
                                        <TextBlock Text="Name in Intune" Style="{StaticResource FieldLabel}"/>
                                        <TextBox AutomationProperties.Name="Name in Intune" Style="{StaticResource TextField}" Padding="11,0" Margin="0,6,0,10"
                                                 Text="{Binding IntuneDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <ContentControl Style="{StaticResource DlRow}" Tag="Application" Content="{Binding DisplayTitle}"/>
                                        <ContentControl Style="{StaticResource DlRow}" Tag="Version" Content="{Binding Version}"/>
                                        <ContentControl Style="{StaticResource DlRow}" Tag="Install context" Content="{Binding InstallContext}"/>
                                        <ContentControl Style="{StaticResource DlRow}" Tag="Size" Content="{Binding SizeText}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Detection method card -->
                        <Border Style="{StaticResource Card}" Margin="0,18,0,0" VerticalAlignment="Top">
                            <StackPanel>
<DockPanel Margin="0,0,0,14">
    <TextBlock DockPanel.Dock="Left" Text="DETECTION METHOD" Style="{StaticResource SectionLabel}"/>
    <TextBlock DockPanel.Dock="Right" Text="How Intune confirms the app is installed" Style="{StaticResource Caption}"/>
    <Border Style="{StaticResource Rule}"/>
</DockPanel>

                                <!-- Rule list -->
                                <ItemsControl ItemsSource="{Binding DetectionRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource RowIconButton}" VerticalAlignment="Top" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Remove rule">
                                                        <Viewbox Width="13" Height="13">
                                                            <Path Data="{StaticResource IconX}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        </Viewbox>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="No detection rule yet — add one below." FontSize="12.5" Foreground="{DynamicResource Muted2Brush}" Margin="0,0,0,6">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DetectionRules.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Add-rule editor -->
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,6,0,0">
                                    <StackPanel>
                                        <ComboBox ItemsSource="{Binding DetectionMethods}" SelectedItem="{Binding NewRuleMethod, Mode=TwoWay}"
                                                  Height="40" VerticalContentAlignment="Center"/>

                                        <!-- File exists / File version -->
                                        <StackPanel Visibility="{Binding IsFileMethod, Converter={StaticResource BoolToVis}}">
                                            <TextBox Style="{StaticResource TextField}" Padding="11,0" Margin="0,8,0,0"
                                                     local:PlaceholderText.Text="Folder path, e.g. %ProgramFiles%\Contoso"
                                                     Text="{Binding NewRulePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox Style="{StaticResource TextField}" Padding="11,0" Margin="0,8,0,0"
                                                     local:PlaceholderText.Text="File or folder name"
                                                     Text="{Binding NewRuleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                        Visibility="{Binding IsFileVersionMethod, Converter={StaticResource BoolToVis}}">
                                                <ComboBox ItemsSource="{Binding Operators}" SelectedItem="{Binding NewRuleOperator, Mode=TwoWay}"
                                                          Width="180" Height="36" VerticalContentAlignment="Center"/>
                                                <TextBox Style="{StaticResource TextField}" Padding="11,0" Width="140" Margin="8,0,0,0"
                                                         local:PlaceholderText.Text="Version"
                                                         Text="{Binding NewRuleValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Registry key exists -->
                                        <StackPanel Visibility="{Binding IsRegistryMethod, Converter={StaticResource BoolToVis}}">
                                            <ComboBox ItemsSource="{Binding RegistryHives}" SelectedItem="{Binding NewRuleHive, Mode=TwoWay}"
                                                      Height="40" Margin="0,8,0,0" VerticalContentAlignment="Center"/>
                                            <TextBox Style="{StaticResource TextField}" Padding="11,0" Margin="0,8,0,0"
                                                     local:PlaceholderText.Text="Key path, e.g. SOFTWARE\Contoso\App"
                                                     Text="{Binding NewRuleKeyPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox Style="{StaticResource TextField}" Padding="11,0" Margin="0,8,0,0"
                                                     local:PlaceholderText.Text="Value name (blank checks the key itself)"
                                                     Text="{Binding NewRuleValueName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <!-- MSI product code -->
                                        <StackPanel Visibility="{Binding IsMsiMethod, Converter={StaticResource BoolToVis}}">
                                            <TextBox Style="{StaticResource TextField}" Padding="11,0" Margin="0,8,0,0"
                                                     local:PlaceholderText.Text="{}{00000000-0000-0000-0000-000000000000}"
                                                     Text="{Binding NewRuleProductCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="No MSI found in the package — enter the product code manually."
                                                       FontSize="11.5" Foreground="{DynamicResource WarnBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding HasNoMsiProductCode, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <Button Style="{StaticResource CardActionButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                                Command="{Binding AddRuleCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="14" Height="14">
                                                    <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="2.3" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Viewbox>
                                                <TextBlock Text="Add detection rule" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- RIGHT COLUMN: Assignment -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
<DockPanel Margin="0,0,0,14">
    <TextBlock DockPanel.Dock="Left" Text="ASSIGNMENT" Style="{StaticResource SectionLabel}"/>
    <TextBlock DockPanel.Dock="Right" Text="Who receives this app" Style="{StaticResource Caption}"/>
    <Border Style="{StaticResource Rule}"/>
</DockPanel>

                            <!-- Intent toggle -->
                            <TextBlock Text="Assignment type" Style="{StaticResource FieldLabel}" Margin="0,0,0,7"/>
                            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="4" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource ContextToggle}" GroupName="Intent" Content="Required"
                                                 IsChecked="{Binding GroupPicker.Intent, Mode=TwoWay, Converter={StaticResource StringMatch}, ConverterParameter=required}"/>
                                    <RadioButton Style="{StaticResource ContextToggle}" GroupName="Intent" Content="Available" Margin="3,0,0,0"
                                                 IsChecked="{Binding GroupPicker.Intent, Mode=TwoWay, Converter={StaticResource StringMatch}, ConverterParameter=available}"/>
                                    <RadioButton Style="{StaticResource ContextToggle}" GroupName="Intent" Content="Uninstall" Margin="3,0,0,0"
                                                 IsChecked="{Binding GroupPicker.Intent, Mode=TwoWay, Converter={StaticResource StringMatch}, ConverterParameter=uninstall}"/>
                                </StackPanel>
                            </Border>

                            <!-- Group search -->
                            <TextBlock Text="Assignment groups" Style="{StaticResource FieldLabel}" Margin="0,16,0,7"/>
                            <Grid>
                                <TextBox AutomationProperties.Name="Assignment groups" x:Name="GroupSearchBox" Style="{StaticResource TextField}" Padding="11,0,92,0"
                                         local:PlaceholderText.Text="Search Entra groups…"
                                         Text="{Binding GroupPicker.GroupQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="GroupSearch_KeyDown"/>
                                <Button Style="{StaticResource BrowseButton}" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                        Margin="0,6,6,6" Command="{Binding GroupPicker.SearchGroupsCommand}">
                                    <TextBlock Text="Search" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>

                            <TextBlock Text="{Binding GroupPicker.GroupSearchHint}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GroupPicker.GroupSearchHint}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Search results -->
                            <ItemsControl ItemsSource="{Binding GroupPicker.GroupResults}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalContentAlignment="Stretch" Margin="0,0,0,6" Cursor="Hand"
                                                Command="{Binding DataContext.GroupPicker.AddGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="12,9">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Viewbox Width="14" Height="14" Margin="0,0,9,0">
                                                                <Path Data="{StaticResource IconGroup}" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                            </Viewbox>
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="12.5" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Selected chips -->
                            <ItemsControl ItemsSource="{Binding GroupPicker.SelectedGroups}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PrimaryDimBrush}" BorderBrush="{DynamicResource AccentTextBrush}" BorderThickness="1"
                                                CornerRadius="4" Padding="11,6" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="13" Height="13" Margin="0,0,7,0">
                                                    <Path Data="{StaticResource IconGroup}" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Viewbox>
                                                <TextBlock Text="{Binding GroupName}" FontSize="12.5" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Button Margin="9,0,0,0" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0"
                                                        Command="{Binding DataContext.GroupPicker.RemoveGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Viewbox Width="11" Height="11">
                                                        <Path Data="{StaticResource IconX}" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="2.2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,4,0,0" FontSize="12.5" Foreground="{DynamicResource MutedBrush}">
                                <Run Text="Assigned as "/>
                                <Run Text="{Binding GroupPicker.IntentLabel, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                <Run Text="."/>
                            </TextBlock>

                            <!-- Upload button -->
                            <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,18,0,0"
                                    Command="{Binding UploadCommand}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                        <Path Data="{StaticResource IconUpload}" Stroke="{DynamicResource PrimaryFgBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                    <TextBlock Text="Upload to Intune" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Not signed in notice -->
                            <Border Background="{DynamicResource BadSoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,14,0,0"
                                    Visibility="{Binding IsNotSignedIn, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                           Text="Not signed in to Intune. Open Settings and sign in before uploading."/>
                            </Border>

                            <!-- Signed-in note -->
                            <Border Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,14,0,0"
                                    Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap">
                                    <Run Text="Connected to "/>
                                    <Run Text="{Binding TenantName, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                    <Run Text=" tenant. No signing or build step — the package is published as-is."/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ PUBLISHING OVERLAY ============ -->
        <Grid Background="{DynamicResource BgBrush}" Visibility="{Binding Publish.IsPublishing, Converter={StaticResource BoolToVis}}">
            <StackPanel Width="560" VerticalAlignment="Center" HorizontalAlignment="Center">

                <!-- Spinner (running) -->
                <Viewbox Width="56" Height="56" HorizontalAlignment="Center"
                         Visibility="{Binding Publish.IsRunning, Converter={StaticResource BoolToVis}}">
                    <Grid Width="44" Height="44" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Grid.RenderTransform>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="IsVisible" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard Name="Spin">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="Spin"/>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Ellipse Width="44" Height="44" Stroke="{DynamicResource LineBrush}" StrokeThickness="4"/>
                        <Path Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M22,2 A20,20 0 0 1 42,22"/>
                    </Grid>
                </Viewbox>

                <!-- Done check (complete & success) -->
                <Border Width="52" Height="52" CornerRadius="4" Background="{DynamicResource OkSoftBrush}" HorizontalAlignment="Center"
                        Visibility="{Binding Publish.IsSucceeded, Converter={StaticResource BoolToVis}}">
                    <Viewbox Width="22" Height="22">
                        <Path Data="{StaticResource IconCheck}" Stroke="{DynamicResource OkBrush}" StrokeThickness="2.6" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Viewbox>
                </Border>

                <!-- Error mark (complete & failed) -->
                <Border Width="52" Height="52" CornerRadius="4" Background="{DynamicResource BadSoftBrush}" HorizontalAlignment="Center"
                        Visibility="{Binding Publish.IsFailed, Converter={StaticResource BoolToVis}}">
                    <Viewbox Width="20" Height="20">
                        <Path Data="{StaticResource IconX}" Stroke="{DynamicResource BadBrush}" StrokeThickness="2.4" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Viewbox>
                </Border>

                <TextBlock Text="{Binding Publish.Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                           HorizontalAlignment="Center" Margin="0,18,0,0"/>
                <TextBlock Text="Building the Win32 package and pushing to Microsoft Intune. This usually takes ~30 seconds — keep this tab open."
                           FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,8,0,0"
                           Visibility="{Binding Publish.IsRunning, Converter={StaticResource BoolToVis}}"/>

                <!-- Steps -->
                <ItemsControl ItemsSource="{Binding Publish.Steps}" Margin="0,24,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="16,14" Margin="0,0,0,10"
                                    Background="{DynamicResource CardBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
                                                <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- status circle -->
                                    <Grid Grid.Column="0" Width="26" Height="26" VerticalAlignment="Center">
                                        <!-- done -->
                                        <Border CornerRadius="4" Background="{DynamicResource OkBrush}" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                                            <Viewbox Width="13" Height="13">
                                                <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Viewbox>
                                        </Border>
                                        <!-- working -->
                                        <Border CornerRadius="4" Background="{DynamicResource PrimaryBrush}" Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}"/>
                                        <!-- error -->
                                        <Border CornerRadius="4" Background="{DynamicResource BadBrush}" Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}">
                                            <Viewbox Width="12" Height="12">
                                                <Path Data="{StaticResource IconX}" Stroke="White" StrokeThickness="2.4" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Viewbox>
                                        </Border>
                                        <!-- pending -->
                                        <Border CornerRadius="4" Background="{DynamicResource Line2Brush}" Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Muted2Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="13,0,0,0" VerticalAlignment="Center"
                                               FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>

                                    <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Cancel while running -->
                <StackPanel Visibility="{Binding Publish.IsRunning, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Center" Margin="0,16,0,0"
                            Command="{Binding Publish.CancelCommand}" Content="Cancel upload"
                            AutomationProperties.Name="Cancel upload"
                            ToolTip="Stops the upload. Anything already created in Intune is removed."/>
                </StackPanel>

                <!-- Result + Done -->
                <StackPanel Visibility="{Binding Publish.IsComplete, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                    <TextBlock Text="{Binding Publish.ResultText}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,16,0,0"
                            Command="{Binding Publish.DoneCommand}" Content="Done"
                            AutomationProperties.Name="Done"/>
                </StackPanel>
            </StackPanel>
        </Grid>

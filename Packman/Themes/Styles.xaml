<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Packman">

    <!-- ═══════════════ Type ═══════════════ -->
    <!-- Segoe UI Variable for UI, Cascadia where columns have to line up, bundled
         Fonts/ faces last. The pack URI must lead: everything after the '#' is the
         fallback list. A pack URI placed later cannot parse, as its own commas
         split it into junk family names. -->
    <FontFamily x:Key="UIFontFamily">pack://application:,,,/Fonts/#Segoe UI Variable Text, Segoe UI, Instrument Sans</FontFamily>
    <FontFamily x:Key="MonoFontFamily">pack://application:,,,/Fonts/#Cascadia Mono, Consolas, JetBrains Mono</FontFamily>
    <FontFamily x:Key="LabelFontFamily">pack://application:,,,/Fonts/#Segoe UI Variable Small, Segoe UI, Martian Mono</FontFamily>

    <!-- ═══════════════ Focus ═══════════════ -->
    <!-- Keyboard focus is an accent hairline. Drawn as an adorner so it never
         shifts layout, and WPF only shows it when the last input was the keyboard. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="6" RadiusY="6" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inset variant for full-bleed rows, where an outside ring would clip. -->
    <Style x:Key="FocusVisualInset">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="1" RadiusX="5" RadiusY="5" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════ Card ═══════════════ -->
    <!-- Fluent card: a translucent layer with a 1px stroke and an 8px radius.
         Separation comes from the layer and the stroke, never a shadow. -->
    <Style x:Key="Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="22,20"/>
    </Style>


    <!-- ═══════════════ Headings ═══════════════ -->
    <Style x:Key="H1" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="H2" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="SubText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted2Brush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <!-- Uppercase letterspaced section label: the recurring rule-and-caption header. -->
    <!-- Stroke-only line icon: every Path drawn from Icons.xaml uses this plus its own Stroke/thickness. -->
    <Style x:Key="Icon" TargetType="{x:Type Path}">
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
    </Style>

    <!-- Row in a search-results dropdown. -->
    <Style x:Key="PickerRow" TargetType="{x:Type Button}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="rb" Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="rb" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource LabelFontFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Small monospace caption sitting at the right end of a section rule. -->
    <Style x:Key="Caption" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource Dim2Brush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>


    <!-- Hairline used between a label and its trailing caption. -->
    <Style x:Key="Rule" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="1"/>
        <!-- Keeps a gap even when the trailing caption eats the row. -->
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="Background" Value="{DynamicResource LineBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="12,0"/>
    </Style>

    <!-- ═══════════════ Buttons ═══════════════ -->
    <!-- Fluent buttons: 4px radius, 34px minimum height, SemiBold label. -->
    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryFgBrush}"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Primary2Brush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ghost (outlined) -->
    <Style x:Key="GhostButton" TargetType="{x:Type Button}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Top-bar text action (DOCS / ALERTS) -->
    <Style x:Key="BarButton" TargetType="{x:Type Button}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted2Brush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="4,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon button (26×26, square) -->
    <Style x:Key="IconButton" TargetType="{x:Type Button}">
        <!-- Icon-only: the tooltip is the accessible name, so screen readers
             announce these instead of reading an empty button. -->
        <Setter Property="AutomationProperties.Name"
                Value="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted2Brush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BackButton" TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButton}"/>


    <!-- Browse (sits inside a field, so it matches the field's inner height) -->
    <Style x:Key="BrowseButton" TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Padding" Value="10,6"/>
    </Style>

    <Style x:Key="CardActionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <!-- Compact pair for editor toolbars and code rows, where a 34px button
         would tower over the line it sits on. -->
    <Style x:Key="MiniButton" TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButton}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding" Value="11,4"/>
    </Style>

    <Style x:Key="MiniPrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding" Value="12,4"/>
    </Style>

    <!-- Optional-tool card: a panel whose left edge lights up on hover. -->
    <Style x:Key="ToolCard" TargetType="{x:Type Button}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"
                                Padding="17,14">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                        </Border>
                        <Border x:Name="edge" Width="3" Height="18" CornerRadius="2" Margin="1,0,0,0"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource EdgeBrush}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryFaintBrush}"/>
                            <Setter TargetName="edge" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════ Input ═══════════════ -->
    <!-- Fluent field: rounded, with the accent underline growing along the
         bottom edge on focus. -->
    <Style x:Key="TextField" TargetType="{x:Type TextBox}">
        <!-- The label is a sibling TextBlock, so there is nothing to announce here.
             The tooltip becomes the name; fields without one set it at the use site. -->
        <Setter Property="AutomationProperties.Name"
                Value="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"/>
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
        <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryDimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="TextAlignment" Value="Left"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <Grid>
                            <Border x:Name="edge" Height="2" VerticalAlignment="Bottom" CornerRadius="0,0,3,3"
                                    Background="{DynamicResource EdgeBrush}"/>
                            <TextBlock x:Name="ph" Text="{Binding (local:PlaceholderText.Text), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource Dim2Brush}" FontSize="{TemplateBinding FontSize}"
                                       Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                            <!-- No margin here: the TextBox already insets its own text by Padding,
                                 so repeating it would push a value twice as far in as the placeholder. -->
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Edge2Brush}"/>
                            <Setter TargetName="edge" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MonoField" TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextField}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>

    <!-- ═══════════════ Sidebar nav item ═══════════════ -->
    <!-- Active state is a 2px accent edge plus a faint accent wash, never a fill. -->
    <!-- NavigationView item: a rounded subtle-fill row, with the accent
         selection pill riding the left edge of the selected one. -->
    <Style x:Key="NavItem" TargetType="{x:Type RadioButton}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualInset}"/>
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted2Brush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Margin" Value="4,1"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <Border x:Name="pill" Width="3" Height="0" CornerRadius="2" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Background="{DynamicResource PrimaryBrush}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                            <Setter TargetName="pill" Property="Height" Value="16"/>
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════ Segmented toggles ═══════════════ -->
    <!-- Checked segment is a solid accent block with dark text. -->
    <Style x:Key="ModeToggle" TargetType="{x:Type RadioButton}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted2Brush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <Border x:Name="mark" Height="2" Width="0" CornerRadius="1" Margin="0,0,0,4"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Background="{DynamicResource PrimaryBrush}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <!-- Fill plus an accent underline, not an accent block: a filled
                             segment would compete with the primary action. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                            <Setter TargetName="mark" Property="Width" Value="18"/>
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ContextToggle" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource ModeToggle}"/>

    <!-- Wrapper that draws the 1px box around a segmented pair. -->
    <Style x:Key="SegmentGroup" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- ═══════════════ Tabs ═══════════════ -->
    <Style x:Key="PageTab" TargetType="{x:Type RadioButton}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted2Brush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                            BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="0,0,0,-1">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DetailTab" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource PageTab}"/>

    <!-- Settings section row in the left list -->
    <Style x:Key="SectionItem" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource NavItem}">
        <Setter Property="Padding" Value="13,10"/>
    </Style>

    <!-- ═══════════════ ComboBox ═══════════════ -->
    <Style TargetType="{x:Type ComboBoxItem}">
        <!-- The highlight already says where focus is; the stock dotted rectangle
             just adds noise inside the flyout. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="11,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            CornerRadius="4" Margin="4,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryDimBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <!-- As TextField: the tooltip carries the accessible name. -->
        <Setter Property="AutomationProperties.Name"
                Value="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="26"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  VerticalAlignment="Center"/>
                                <Viewbox Grid.Column="1" Width="11" Height="11" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Path Data="M4 8l6 6 6-6" Stroke="{DynamicResource Dim2Brush}" StrokeThickness="1.8"
                                          Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <!-- Style="{x:Null}" is load-bearing: without it this inherits WPF UI's
                                 implicit ToggleButton style, which swallows the click and
                                 kills the drop-down. -->
                                <ToggleButton Style="{x:Null}" Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0"
                                             IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Border>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                               Placement="Bottom" PopupAnimation="Fade">
                            <!-- FlyoutBrush, not CardBrush: this floats over arbitrary
                                 content, and the card layers are translucent. -->
                            <Border Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource ControlStrokeBrush}"
                                    BorderThickness="1" CornerRadius="8" Margin="0,2,0,0" Padding="0,4"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Edge2Brush}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════ Applications table ═══════════════ -->
    <Style x:Key="ColHead" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource LabelFontFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource Dim2Brush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
    </Style>

    <!-- Status badge (bind to an object exposing StatusKind + StatusLabel) -->
    <DataTemplate x:Key="StatusBadgeTemplate">
        <Border x:Name="bg" CornerRadius="4" Padding="7,4" Background="Transparent"
                BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeBrush}">
            <TextBlock x:Name="lbl" Text="{Binding StatusLabel}" FontFamily="{StaticResource LabelFontFamily}"
                       FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource Muted2Brush}" VerticalAlignment="Center"/>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource OkLineBrush}"/>
                <Setter TargetName="lbl" Property="Foreground" Value="{DynamicResource OkBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKind}" Value="warn">
                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource WarnLineBrush}"/>
                <Setter TargetName="lbl" Property="Foreground" Value="{DynamicResource WarnBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKind}" Value="bad">
                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource BadLineBrush}"/>
                <Setter TargetName="lbl" Property="Foreground" Value="{DynamicResource BadBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>



    <!-- Row action button (⋯) -->
    <Style x:Key="RowIconButton" TargetType="{x:Type Button}">
        <!-- Icon-only: the tooltip is the accessible name, so screen readers
             announce these instead of reading an empty button. -->
        <Setter Property="AutomationProperties.Name"
                Value="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted2Brush}"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Line2Brush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Breadcrumb back -->
    <Style x:Key="Breadcrumb" TargetType="{x:Type Button}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="Transparent" Padding="0,2">
                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════ Detail rows ═══════════════ -->
    <Style x:Key="DlRow" TargetType="{x:Type ContentControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,0,0,1" Padding="0,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{TemplateBinding Tag}" FontFamily="{StaticResource UIFontFamily}"
                                       FontSize="11.5" Foreground="{DynamicResource Muted2Brush}" VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0,0,0"
                                              TextElement.Foreground="{DynamicResource TextBrush}"
                                              TextElement.FontFamily="{StaticResource UIFontFamily}"
                                              TextElement.FontWeight="SemiBold" TextElement.FontSize="12"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DlRowMono" TargetType="{x:Type ContentControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,0,0,1" Padding="0,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{TemplateBinding Tag}" FontFamily="{StaticResource UIFontFamily}"
                                       FontSize="11.5" Foreground="{DynamicResource Muted2Brush}" VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0,0,0"
                                              TextElement.Foreground="{DynamicResource TextBrush}"
                                              TextElement.FontFamily="{StaticResource MonoFontFamily}" TextElement.FontSize="12"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Deployment stat line: Foreground = dot colour, Tag = label, Content = count -->
    <Style x:Key="StatRow" TargetType="{x:Type ContentControl}">
        <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,0,0,1" Padding="0,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}"/>
                            <TextBlock Grid.Column="1" Text="{TemplateBinding Tag}" Margin="9,0,0,0" FontFamily="{StaticResource UIFontFamily}"
                                       FontSize="12" Foreground="{DynamicResource Muted2Brush}" VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource InkBrush}"
                                              TextElement.FontFamily="{StaticResource MonoFontFamily}" TextElement.FontSize="12"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="StatRowWarn" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource StatRow}">
        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
    </Style>
    <Style x:Key="StatRowBad" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource StatRow}">
        <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
    </Style>
    <Style x:Key="StatRowMut" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource StatRow}">
        <Setter Property="Foreground" Value="{DynamicResource Muted3Brush}"/>
    </Style>

    <!-- ═══════════════ Status list row ═══════════════ -->
    <!-- Publish steps, signing checks and scope lists all share this shape:
         a 2px status edge, a mark, a label and a trailing note. -->

    <!-- ═══════════════ Progress ═══════════════ -->
    <!-- 4px rail, rounded ends. Without it the progress bars fall through to
         the stock Windows template and bring its blue with them. -->
    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource EdgeBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                        <!-- PART_Track measures the span the indicator is sized against. -->
                        <Border x:Name="PART_Track"/>
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2"
                                Background="{TemplateBinding Foreground}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════ Scrollbar ═══════════════ -->
    <!-- Left to WPF UI: its ScrollBar is the Fluent overlay rail that thickens
         on hover, which the hand-rolled template here never matched. -->

</ResourceDictionary>

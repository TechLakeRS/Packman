<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Packman</RootNamespace>
    <AssemblyName>Packman</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <Authors>TechLakeRS</Authors>
    <RepositoryUrl>https://github.com/TechLakeRS/Packman</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Packman.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Client" Version="4.67.2" />
    <PackageReference Include="Microsoft.Identity.Client.Broker" Version="4.67.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- PowerShell remoting for the Remote Test tool. Pinned to the version vendored in
         packages/; bump both together. -->
    <PackageReference Include="System.Management.Automation" Version="7.5.10" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Console UI fonts, embedded so they render without machine installation -->
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\third-party\**\*" Link="third-party\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fonts\*-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fonts\README.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- Bundled PSADT v4 template, copied next to the executable -->
    <None Include="PSADT\**\*" Exclude="PSADT\**\.gitkeep" CopyToOutputDirectory="PreserveNewest" />
    <!-- Monaco editor assets for the in-app script editor -->
    <None Include="MonacoEditor\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- PSADT v4 function catalog used by the Configure PSADT dialog -->
    <None Include="PSADT_v4_Functions*.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
